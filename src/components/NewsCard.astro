---
import { getLangFromUrl, formatDate } from '../i18n/utils.js';

// 뉴스는 글로만 보여준다. 사진은 갤러리 페이지에서 따로 다룬다.
// href 가 있으면 카드 전체가 링크가 된다. 없으면 호버 반응 없는 정적 카드.
const { item, href } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const d = item.data;

const title = lang === 'ko' ? d.title_ko || d.title : d.title;
const summary = lang === 'ko' ? d.summary_ko || d.summary : d.summary;
const tag = lang === 'ko' ? d.tag_ko || d.tag : d.tag;
const fileLabel = lang === 'ko' ? d.file_label_ko || d.file_label : d.file_label;
const Tag = href ? 'a' : 'article';
---

<Tag class:list={['card', 'news-card', { 'card-hover': href }]} href={href}>
  <p class="meta">
    <time datetime={d.date.toISOString().slice(0, 10)}>
      {formatDate(d.date, lang, { monthOnly: true })}
    </time>
    {tag && <span class="tag">{tag}</span>}
  </p>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  {
    d.file && !href && (
      <p class="attach">
        <a href={d.file} target="_blank" rel="noopener">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M8 2v8m0 0L5 7m3 3l3-3M3 13h10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {fileLabel ?? d.file.split('/').pop()}
        </a>
      </p>
    )
  }
</Tag>

<style>
  a.news-card {
    color: inherit;
    text-decoration: none;
  }
  a.news-card:hover {
    text-decoration: none;
  }

  .news-card {
    display: flex;
    flex-direction: column;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 620;
    line-height: 1.42;
    margin-bottom: 0.45rem;
    letter-spacing: -0.008em;
  }

  .summary {
    margin: 0;
    font-size: 0.885rem;
    line-height: 1.62;
    color: var(--body);
  }

  .attach {
    margin: 0.85rem 0 0;
  }
  .attach a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
