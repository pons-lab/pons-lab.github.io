---
import { site } from '../lib/data.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath, alternatePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (item) => {
  const path = typeof item === 'string' ? item : (item.matchPrefix ?? item.path);
  const target = localizePath(path, lang).replace(/\/$/, '');
  return current === target || current.startsWith(`${target}/`);
};

const otherLang = lang === 'ko' ? 'en' : 'ko';
const otherLabel = lang === 'ko' ? 'EN' : 'KO';
const otherHref = alternatePath(Astro.url.pathname, otherLang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
          <rect width="32" height="32" rx="9" fill="var(--ink)"></rect>
          <path
            d="M7 21c3.2 0 3.6-9 6.6-9 2.4 0 2.6 6.2 4.9 6.2 2.1 0 2.4-4.6 4.3-4.6"
            stroke="#7ea6ff"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="brand-text">
        <strong>{site.name.short_en}</strong>
        <small>{lang === 'ko' ? site.name.full_ko : site.name.full_en}</small>
      </span>
    </a>

    <nav class="nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li class={item.children ? 'has-menu' : undefined}>
              <a
                href={localizePath(item.path, lang)}
                class={isActive(item) ? 'active' : ''}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {t(item.key)}
                {item.children && (
                  <svg class="caret" width="10" height="10" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M4 6l4 4 4-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </a>
              {item.children && (
                <ul class="submenu">
                  {item.children.map((sub) => (
                    <li>
                      <a
                        href={localizePath(sub.path, lang)}
                        class={isActive(sub) ? 'active' : ''}
                        aria-current={isActive(sub) ? 'page' : undefined}
                      >
                        {t(sub.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="lang-switch" href={otherHref} lang={otherLang} aria-label={t('a11y.lang')}>
        {otherLabel}
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr-only">{t('nav.menu')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label={t('nav.menu')}>
    <ul class="container">
      <li><a href={home}>{t('nav.home')}</a></li>
      {
        navItems.map((item) =>
          item.children ? (
            item.children.map((sub) => (
              <li>
                <a href={localizePath(sub.path, lang)} class={isActive(sub) ? 'active' : ''}>
                  {t(sub.key)}
                </a>
              </li>
            ))
          ) : (
            <li>
              <a href={localizePath(item.path, lang)} class={isActive(item) ? 'active' : ''}>
                {t(item.key)}
              </a>
            </li>
          )
        )
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 252, 254, 0.86);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 70px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    flex: none;
  }
  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .brand-text small {
    font-size: 0.685rem;
    color: var(--muted);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 34ch;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .nav a {
    display: block;
    padding: 0.5rem 0.72rem;
    border-radius: 8px;
    color: var(--body);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav a:hover {
    color: var(--ink);
    background: #eef2f9;
    text-decoration: none;
  }
  .nav a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* ── Publications 드롭다운 ─────────────────────────────────────────
     마우스를 올리거나(:hover) 키보드로 초점이 들어오면(:focus-within) 열린다.
     상위 항목 자체가 학술지 페이지 링크라, 터치로 누르면 바로 그 페이지로 간다. */
  .has-menu {
    position: relative;
  }
  .has-menu > a {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
  }
  .caret {
    opacity: 0.55;
    transition: transform 0.18s ease;
  }
  .has-menu:hover .caret,
  .has-menu:focus-within .caret {
    transform: rotate(180deg);
    opacity: 1;
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    display: grid !important;
    gap: 0.1rem;
    min-width: 14rem;
    margin-top: 0.3rem;
    padding: 0.4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .has-menu:hover .submenu,
  .has-menu:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* 메뉴와 상위 항목 사이의 빈 틈에서 마우스가 빠지지 않도록 */
  .has-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 0.5rem;
  }

  .submenu a {
    display: block;
    white-space: nowrap;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    font-size: 0.885rem;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 34px;
    padding-inline: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--body);
    font-size: 0.775rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .lang-switch:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 36px;
    align-items: center;
    justify-content: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 9px;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars i {
    display: block;
    width: 17px;
    height: 1.8px;
    background: var(--ink);
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--card);
    padding-block: 0.5rem 0.9rem;
  }
  .mobile-nav ul {
    display: grid;
  }
  .mobile-nav a {
    display: block;
    padding: 0.72rem 0.2rem;
    color: var(--body);
    font-size: 0.98rem;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .mobile-nav li:last-child a {
    border-bottom: 0;
  }
  .mobile-nav a.active {
    color: var(--accent);
  }

  @media (max-width: 1040px) {
    .nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .brand-text small {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const setOpen = (open) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // 메뉴 안 링크를 누르면 패널을 닫고, Escape 로도 닫는다.
  panel?.addEventListener('click', (e) => {
    if (e.target.closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;

    // 키보드로 연 드롭다운은 :focus-within 으로 열려 있으므로 초점을 상위 항목으로
    // 되돌리면 닫힌다. (WCAG 1.4.13 — 초점으로 띄운 내용은 Escape 로 닫을 수 있어야 함)
    const inMenu = document.activeElement?.closest('.has-menu');
    if (inMenu) {
      inMenu.querySelector(':scope > a')?.focus();
      inMenu.blur?.();
      document.activeElement?.blur();
      return;
    }

    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    toggle.focus();
  });

  // 데스크톱 폭으로 넓어지면 열린 패널이 남지 않도록 정리한다.
  matchMedia('(min-width: 1041px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
