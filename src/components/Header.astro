---
import { site } from '../lib/data.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath, alternatePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (path) => {
  const target = localizePath(path, lang).replace(/\/$/, '');
  return current === target || current.startsWith(`${target}/`);
};

const university = lang === 'ko' ? site.institution.university_ko : site.institution.university_en;
const enHref = alternatePath(Astro.url.pathname, 'en');
const koHref = alternatePath(Astro.url.pathname, 'ko');
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={home}>
      <b>{site.name.short_en}</b>
      <span>{university}</span>
    </a>

    <nav class="menu" aria-label={t('nav.menu')}>
      {
        navItems.map((item) => (
          <a
            href={localizePath(item.path, lang)}
            class={isActive(item.path) ? 'active' : ''}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <div class="lang" aria-label={t('a11y.lang')}>
        <a href={enHref} class={lang === 'en' ? 'on' : ''} lang="en">EN</a>
        <span aria-hidden="true">·</span>
        <a href={koHref} class={lang === 'ko' ? 'on' : ''} lang="ko">KO</a>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr-only">{t('nav.menu')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label={t('nav.menu')}>
    <ul class="container">
      <li><a href={home}>{t('nav.home')}</a></li>
      {
        navItems.map((item) => (
          <li>
            <a href={localizePath(item.path, lang)} class={isActive(item.path) ? 'active' : ''}>
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 252, 254, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: none;
    min-width: 0;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo b {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .logo span {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu {
    display: flex;
    gap: 26px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--body);
  }
  .menu a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .menu a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .menu a.active {
    color: var(--accent);
    font-weight: 600;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 4px 12px;
    color: var(--muted);
    background: var(--card);
  }
  .lang a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lang a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .lang a.on {
    color: var(--accent);
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 34px;
    align-items: center;
    justify-content: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 9px;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars i {
    display: block;
    width: 16px;
    height: 1.7px;
    background: var(--ink);
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--card);
    padding-block: 0.4rem 0.85rem;
  }
  .mobile-nav ul {
    display: grid;
  }
  .mobile-nav a {
    display: block;
    padding: 0.7rem 0.2rem;
    color: var(--body);
    font-size: 0.96rem;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .mobile-nav li:last-child a {
    border-bottom: 0;
  }
  .mobile-nav a.active {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .menu {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 460px) {
    .logo span {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
