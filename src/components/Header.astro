---
import LogoMark from './LogoMark.astro';
import { site } from '../lib/data.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath, alternatePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (item) => {
  // 같은 페이지 안의 섹션 링크는 현재 위치로 표시하지 않는다 (상위 메뉴만 표시).
  if (typeof item !== 'string' && item.path?.includes('#')) return false;
  const path = typeof item === 'string' ? item : (item.matchPrefix ?? item.path);
  const target = localizePath(path, lang).replace(/\/$/, '');
  return current === target || current.startsWith(`${target}/`);
};

const otherLang = lang === 'ko' ? 'en' : 'ko';
const otherLabel = lang === 'ko' ? 'EN' : 'KO';
const otherHref = alternatePath(Astro.url.pathname, otherLang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <LogoMark size={36} />
      <span class="brand-text">
        <strong>{site.name.short_en}</strong>
        <small>{lang === 'ko' ? site.name.full_ko : site.name.full_en}</small>
      </span>
    </a>

    <nav class="nav" aria-label={t('nav.menu')} lang={lang === 'ko' ? 'en' : undefined}>
      <ul>
        {
          navItems.map((item) => (
            <li class={item.children ? 'has-menu' : undefined}>
              <a
                href={localizePath(item.path, lang)}
                class={isActive(item) ? 'active' : ''}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {t(item.key)}
                {item.children && (
                  <svg class="caret" width="10" height="10" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M4 6l4 4 4-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </a>
              {item.children && (
                <ul class="submenu">
                  {item.children.map((sub) => (
                    <li>
                      <a
                        href={localizePath(sub.path, lang)}
                        class={isActive(sub) ? 'active' : ''}
                        aria-current={isActive(sub) ? 'page' : undefined}
                      >
                        {t(sub.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        {/* 구성원 전용 페이지. 공개 메뉴가 아니라 작게 끝에 붙인다. */}
        <li class="members">
          <a
            href={localizePath('/members', lang)}
            class={isActive({ path: '/members' }) ? 'active' : ''}
            aria-current={isActive({ path: '/members' }) ? 'page' : undefined}
          >
            {t('nav.members')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <a class="t-btn t-btn--grey t-btn--sm lang-switch" href={otherHref} lang={otherLang} aria-label={t('a11y.lang')}>
        {otherLabel}
      </a>
      <button class="t-iconbtn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr-only">{t('nav.menu')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <nav
    class="mobile-nav"
    id="mobile-nav"
    hidden
    aria-label={t('nav.menu')}
    lang={lang === 'ko' ? 'en' : undefined}
  >
    <ul class="container">
      <li><a href={home}>{t('nav.home')}</a></li>
      {
        navItems.map((item) =>
          item.children ? (
            item.children.map((sub) => (
              <li>
                <a href={localizePath(sub.path, lang)} class={isActive(sub) ? 'active' : ''}>
                  {t(sub.key)}
                </a>
              </li>
            ))
          ) : (
            <li>
              <a href={localizePath(item.path, lang)} class={isActive(item) ? 'active' : ''}>
                {t(item.key)}
              </a>
            </li>
          )
        )
      }
      <li class="members">
        <a href={localizePath('/members', lang)} class={isActive({ path: '/members' }) ? 'active' : ''}>
          {t('nav.members')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-bottom 0.3s ease-in-out;
  }
  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--op-100);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin-right: auto;
    flex: none;
    color: var(--ink);
  }
  .brand:hover {
    text-decoration: none;
  }

  .brand-text {
    font-family: var(--font-logo);
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand-text strong {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink);
  }
  /* 연구실 정식 명칭은 줄이지 않는다. 말줄임표로 잘린 이름은
     이름 구실을 못 한다. 좁아지면(480px) 아래에서 통째로 감춘다. */
  .brand-text small {
    font-size: var(--text-2xs);
    color: var(--muted);
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .nav a {
    display: block;
    padding: 0.5625rem 0.625rem;
    border-radius: 10px;
    color: var(--text-btn);
    font-size: var(--text-md);
    line-height: 1.375rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.15s, background-color 0.15s;
  }
  .nav a:hover {
    background: var(--fill-100);
    text-decoration: none;
  }
  .nav a.active {
    color: var(--accent-fg);
  }

  /* ── Publications 드롭다운 ─────────────────────────────────────────
     마우스를 올리거나(:hover) 키보드로 초점이 들어오면(:focus-within) 열린다.
     상위 항목 자체가 학술지 페이지 링크라, 터치로 누르면 바로 그 페이지로 간다. */
  .has-menu {
    position: relative;
  }
  .has-menu > a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .caret {
    opacity: 0.55;
    transition: transform 0.2s;
  }
  .has-menu:hover .caret,
  .has-menu:focus-within .caret {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* 구성원 전용 링크는 공개 메뉴보다 조용하게 */
  .nav .members > a {
    color: var(--text-5);
    font-weight: 500;
  }
  .nav .members > a:hover,
  .nav .members > a.active {
    color: var(--accent-fg);
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    display: grid !important;
    gap: 0;
    min-width: 14rem;
    margin-top: 0.25rem;
    padding: 0.375rem;
    background: var(--elevated);
    border-radius: 12px;
    box-shadow: var(--shadow-float);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0.15s;
  }
  .has-menu:hover .submenu,
  .has-menu:focus-within .submenu {
    opacity: 1;
    visibility: visible;
  }
  /* 메뉴와 상위 항목 사이의 빈 틈에서 마우스가 빠지지 않도록 */
  .has-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 0.5rem;
  }

  .submenu a {
    border-radius: 8px;
    font-weight: 400;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .menu-toggle {
    display: none;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars i {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-3);
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mobile-nav {
    background: var(--bg);
    padding-block: 0.25rem 1rem;
    box-shadow: 0 8px 12px -8px var(--op-200);
  }
  .mobile-nav ul {
    display: grid;
  }
  .mobile-nav a {
    display: block;
    padding: 0.75rem 0;
    color: var(--text-2);
    font-size: var(--text-base);
    font-weight: 600;
  }
  .mobile-nav a:hover {
    color: var(--accent-fg);
    text-decoration: none;
  }
  .mobile-nav a.active {
    color: var(--accent-fg);
  }

  /* 내비 8개 + 언어 토글 + 연구실 정식 명칭이 한 줄에 다 들어가려면
     1140px 는 있어야 한다. 그 아래는 햄버거로 접는다. */
  @media (max-width: 1140px) {
    .nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .brand-text small {
      display: none;
    }
  }
</style>

<script>
  // 같은 페이지 안으로 이동하는 항목을 누르면 초점을 풀어 드롭다운이 닫히게 한다.
  document.querySelectorAll('.submenu a[href*="#"]').forEach((link) => {
    link.addEventListener('click', () => link.blur());
  });

  // 스크롤을 시작하면 헤더 아래 경계선이 나타난다.
  const header = document.querySelector('.site-header');
  const syncScrolled = () => header?.setAttribute('data-scrolled', String(window.scrollY > 0));
  syncScrolled();
  addEventListener('scroll', syncScrolled, { passive: true });

  const toggle = document.querySelector('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const setOpen = (open) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // 메뉴 안 링크를 누르면 패널을 닫고, Escape 로도 닫는다.
  panel?.addEventListener('click', (e) => {
    if (e.target.closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;

    // 키보드로 연 드롭다운은 :focus-within 으로 열려 있으므로 초점을 상위 항목으로
    // 되돌리면 닫힌다. (WCAG 1.4.13 — 초점으로 띄운 내용은 Escape 로 닫을 수 있어야 함)
    const inMenu = document.activeElement?.closest('.has-menu');
    if (inMenu) {
      inMenu.querySelector(':scope > a')?.focus();
      inMenu.blur?.();
      document.activeElement?.blur();
      return;
    }

    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    toggle.focus();
  });

  // 데스크톱 폭으로 넓어지면 열린 패널이 남지 않도록 정리한다.
  matchMedia('(min-width: 1141px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
