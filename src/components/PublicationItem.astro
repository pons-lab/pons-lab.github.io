---
import Authors from './Authors.astro';
import { doiUrl } from '../lib/data.js';
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';

// level: 이 항목이 놓이는 제목 단계. 홈은 h2 아래라 3, 논문 페이지는 연도 h3 아래라 4.
const { pub, compact = false, level = 3 } = Astro.props;
const Title = `h${level}`;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const link = doiUrl(pub.doi);
const statusLabel = pub.status ? t(`pub.${String(pub.status).replace(/-/g, '_')}`) : null;
---

<article class:list={['pub', { compact }]} lang="en">
  {!compact && <span class="num mono-num">{pub.id}</span>}

  <div class="body">
    <Title class="title">
      {link ? <a href={link} target="_blank" rel="noopener">{pub.title}</a> : pub.title}
    </Title>

    <p class="authors-line"><Authors authors={pub.authors} /></p>

    <p class="meta">
      {pub.venue && <em class="venue">{pub.venue}</em>}
      {pub.detail && <span class="detail">, {pub.detail}</span>}
      {pub.year && <span class="year">, {pub.year}</span>}
      {statusLabel && <span class="status">{statusLabel}</span>}
    </p>

    {
      (link || pub.metrics) && (
        <p class="foot">
          {link && (
            <a class="doi" href={link} target="_blank" rel="noopener">
              doi.org/{pub.doi}
            </a>
          )}
          {pub.metrics && <span class="t-tag">{pub.metrics}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    padding-block: 1.25rem;
  }
  .pub.compact {
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
  }

  .num {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.75rem;
    color: var(--text-5);
  }

  .title,
  h3.title,
  h4.title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 0.375rem;
  }
  .compact .title {
    font-size: var(--text-2xl);
    line-height: 1.45;
  }
  .title a {
    color: inherit;
    transition: color 0.2s;
  }
  .title a:hover {
    color: var(--accent-fg);
    text-decoration: none;
  }

  .authors-line {
    margin: 0 0 0.25rem;
    font-size: var(--text-md);
    color: var(--text-4);
  }

  .meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-4);
  }
  .venue {
    color: var(--text-3);
    font-style: italic;
  }

  .status {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-4);
    font-size: var(--text-3xs);
    font-weight: 600;
    font-style: normal;
  }

  .status:not(:first-child) {
    margin-left: 0.25rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  .doi {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-fg);
    word-break: break-all;
  }

  @media (max-width: 560px) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
