---
/**
 * 서비스 로고와 선 아이콘 한곳 모음.
 *
 *   <ServiceIcon name="github" size={20} />
 *
 * 로고(drive, github, linkedin, scholar, orcid, maps)는 링크가 실제로 그 서비스로 갈 때만 쓴다.
 * 로고 모양은 simple-icons(CC0)와 각 서비스 공개 로고 기준이다. 임의로 고치지 않는다.
 * 선 아이콘(mail, phone, pin, building, checklist, globe)은 글자색을 따른다.
 * 항상 옆에 글자가 함께 있으므로 스크린리더에는 읽히지 않게 둔다.
 * PDF용 CV 에서는 cv-print 쪽 규칙이 아니라 global.css 인쇄 규칙으로 감춘다.
 */
const { name, size = 16 } = Astro.props;
const line = ['mail', 'phone', 'pin', 'building', 'checklist', 'globe'].includes(name);
const box = name === 'drive' ? '0 0 87.3 78' : '0 0 24 24';
---

<svg
  class="svc-icon"
  width={size}
  height={size}
  viewBox={box}
  fill={line ? 'none' : undefined}
  stroke={line ? 'currentColor' : undefined}
  stroke-width={line ? '1.8' : undefined}
  stroke-linecap={line ? 'round' : undefined}
  stroke-linejoin={line ? 'round' : undefined}
  aria-hidden="true"
>
  {
    name === 'drive' && (
      <>
        <path fill="#0066da" d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" />
        <path fill="#00ac47" d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" />
        <path fill="#ea4335" d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" />
        <path fill="#00832d" d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" />
        <path fill="#2684fc" d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" />
        <path fill="#ffba00" d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" />
      </>
    )
  }
  {
    name === 'github' && (
      <path
        fill="#191f28"
        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
      />
    )
  }
  {
    name === 'linkedin' && (
      <path
        fill="#0a66c2"
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
      />
    )
  }
  {
    name === 'scholar' && (
      <path
        fill="#4285f4"
        d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
      />
    )
  }
  {
    name === 'orcid' && (
      <path
        fill="#a6ce39"
