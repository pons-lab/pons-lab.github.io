      />
    )
  }
  {
    name === 'maps' && (
      <>
        <path fill="#34a853" d="M19.527 4.799c1.212 2.608.937 5.678-.405 8.173-1.101 2.047-2.744 3.74-4.098 5.614-.619.858-1.244 1.75-1.669 2.727-.141.325-.263.658-.383.992-.121.333-.224.673-.34 1.008-.109.314-.236.684-.627.687h-.007c-.466-.001-.579-.53-.695-.887-.284-.874-.581-1.713-1.019-2.525-.51-.944-1.145-1.817-1.79-2.671L19.527 4.799z" />
        <path fill="#fbbc04" d="M8.545 7.705l-3.959 4.707c.724 1.54 1.821 2.863 2.871 4.18.247.31.494.622.737.936l4.984-5.925-.029.01c-1.741.601-3.691-.291-4.392-1.987a3.377 3.377 0 0 1-.209-.716c-.063-.437-.077-.761-.004-1.198l.001-.007z" />
        <path fill="#4285f4" d="M5.492 3.149l-.003.004c-1.947 2.466-2.281 5.88-1.117 8.77l4.785-5.689-.058-.05-3.607-3.035z" />
        <path fill="#1a73e8" d="M14.661.436l-3.838 4.563a.295.295 0 0 1 .027-.01c1.6-.551 3.403.15 4.22 1.626.176.319.323.683.377 1.045.068.446.085.773.012 1.22l-.003.016 3.836-4.561A8.382 8.382 0 0 0 14.67.439l-.009-.003z" />
        <path fill="#ea4335" d="M9.466 5.868L14.162.285l-.047-.012A8.31 8.31 0 0 0 11.986 0a8.439 8.439 0 0 0-6.169 2.766l-.016.018 3.665 3.084z" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="m4 7.5 8 5.5 8-5.5" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M6.6 3.5h2.3a1 1 0 0 1 1 .8l.7 3.1a1 1 0 0 1-.3 1l-1.5 1.4a12.5 12.5 0 0 0 5.4 5.4l1.4-1.5a1 1 0 0 1 1-.3l3.1.7a1 1 0 0 1 .8 1v2.3a2 2 0 0 1-2.2 2C10.7 18.9 5.1 13.3 4.6 5.7a2 2 0 0 1 2-2.2z" />
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21.5s7-6.1 7-11.5a7 7 0 1 0-14 0c0 5.4 7 11.5 7 11.5z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {
    name === 'building' && (
      <>
        <rect x="5" y="3" width="14" height="18" rx="2" />
        <path d="M9 7.5h2M13 7.5h2M9 11.5h2M13 11.5h2M10 21v-4.5h4V21" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.500 5.600 12 3z" />
      </>
    )
  }
  {
    name === 'checklist' && (
      <>
        <rect x="4" y="3" width="16" height="18" rx="2.5" />
        <path d="m8 8.5 1.3 1.3L11.5 7.5M8 15l1.3 1.3 2.2-2.3M14.5 9h2M14.5 15.5h2" />
      </>
    )
  }
</svg>

<style>
  .svc-icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.15em;
  }
</style>
