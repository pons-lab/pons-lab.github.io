---
/**
 * 구성원 카드 하나. 내용은 members.yaml 에서 온다.
 * 이름과 합류 시기 외의 항목은 적은 것만 표시한다. 형식은 members.yaml 맨 위 설명을 본다.
 */
import { Image } from 'astro:assets';
import ServiceIcon from './ServiceIcon.astro';
import { asset } from '../lib/images.js';
import { getLangFromUrl, useTranslations, pick } from '../i18n/utils.js';

const { member: m } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = lang === 'ko' ? m.name_ko || m.name_en : m.name_en;
const since = lang === 'ko' ? m.since_ko || m.since : m.since;
const initials = m.name_en
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

const photo = asset(m.photo);
const major = pick(m, 'major', lang);
const education = pick(m, 'education', lang);
const interests = (lang === 'ko' ? m.interests_ko || m.interests_en : m.interests_en) ?? [];

const links = [
  m.email && { icon: 'mail', label: 'Email', href: `mailto:${m.email}` },
  m.scholar_url && { icon: 'scholar', label: 'Google Scholar', href: m.scholar_url },
  m.orcid && { icon: 'orcid', label: 'ORCID', href: `https://orcid.org/${m.orcid}` },
  m.linkedin_url && { icon: 'linkedin', label: 'LinkedIn', href: m.linkedin_url },
  m.github_url && { icon: 'github', label: 'GitHub', href: m.github_url },
  m.website_url && { icon: 'globe', label: 'Website', href: m.website_url },
].filter(Boolean);
---

<li class="card person">
  <div class="face">
    {
      photo ? (
        <Image src={photo} alt={name} width={112} densities={[1, 2]} loading="lazy" />
      ) : (
        <span class="initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>

  <div class="info">
    <p class="name">{name}</p>
    {lang === 'ko' && m.name_ko !== m.name_en && <p class="name-en">{m.name_en}</p>}
    <p class="since mono-num">{t('people.since')} {since}</p>
    {
      m.prior_period && (
        <p class="since">
          {pick(m, 'prior_role', lang)} <span class="mono-num">{m.prior_period}</span>
        </p>
      )
    }

    {major && <p class="detail">{major}</p>}
    {education && <p class="detail muted-detail">{education}</p>}

    {
      interests.length > 0 && (
        <ul class="interests" aria-label={t('people.interests')}>
          {interests.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-label={`${name} ${l.label}`}
                target={l.icon === 'mail' ? undefined : '_blank'}
                rel={l.icon === 'mail' ? undefined : 'noopener'}
              >
                <ServiceIcon name={l.icon} size={16} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .person {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.25rem;
  }

  .face {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
  }
  .face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-5);
  }

  .info {
    min-width: 0;
  }
  .info p {
    margin: 0;
  }

  .name {
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
  }
  .name-en,
  .since {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-4);
  }
  .since {
    margin-top: 0.125rem !important;
  }

  .detail {
    margin-top: 0.625rem !important;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-2);
  }
  .muted-detail {
    margin-top: 0.125rem !important;
    font-weight: 400;
    color: var(--text-4);
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.625rem;
  }
  .interests li {
    padding: 0.125rem 0.5rem;
    border-radius: 6px;
    background: var(--bg);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-3);
  }

  .links {
    display: flex;
    gap: 0.125rem;
    margin: 0.5rem 0 0 -0.375rem;
  }
  .links a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--text-4);
    transition: background-color 0.15s;
  }
  .links a:hover {
    background: var(--fill-100);
  }
</style>
