---
import Affiliation from '../Affiliation.astro';
import Authors from '../Authors.astro';
import {
  site,
  members,
  cv,
  lectures,
  journalsByYear,
  conferencesByScope,
  projectsInOrder,
  doiUrl,
} from '../../lib/data.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pi = members.pi;
const office = site.contact.office;
const { unpublished, groups } = journalsByYear();
const { international, domestic } = conferencesByScope();

// 진행 중인 과제는 역할에 따라 나눠서 싣는다.
const piProjects = projectsInOrder().filter((p) => p.role === 'pi');
const coProjects = projectsInOrder().filter((p) => p.role !== 'pi');

// 학술 경력의 첫 항목(현직)에는 연구실 이름을 함께 적는다.
const labName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
const officeAddress = lang === 'ko' ? office.address_ko : office.address_en;
const levelLabel = (level) =>
  level === 'graduate' ? t('lectures.graduate') : t('lectures.undergraduate');

// 발명자명이 한글이면 lang="ko" 로 표시한다 (한국 특허는 국문 등재명을 그대로 쓴다).
const nameLang = (p) => (/[가-힣]/.test(p.inventors) ? 'ko' : 'en');

---

<article class="cv">
  <header class="cv-head">
    <div class="container">
      <h1>{lang === 'ko' ? `${pi.name_ko} (${pi.name_en})` : pi.name_en}</h1>
      <p class="role">
        <Affiliation prefix={pick(pi, 'title', lang)} />
      </p>
      <p class="contact">
        <span>{officeAddress}</span>
        <span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></span>
        <span><a href={`tel:${office.phone}`}>{office.phone_display}</a></span>
        {pi.scholar_url && (
          <span><a href={pi.scholar_url} target="_blank" rel="noopener">Google Scholar</a></span>
        )}
        {pi.orcid && (
          <span>
            <a href={`https://orcid.org/${pi.orcid}`} target="_blank" rel="noopener">
              ORCID <span class="mono-num">{pi.orcid}</span>
            </a>
          </span>
        )}
      </p>
      <p class="actions">
        <a class="btn btn-primary" href="/cv.pdf" download>{t('cv.download')}</a>
      </p>
    </div>
  </header>

  <div class="container body">
    <!-- 1. Academic Appointments -->
    <section class="cv-sec">
      <h2>{t('cv.appointments')}</h2>
      <ul class="entries">
        {
          pi.experience.map((e, i) => (
            <li>
              <span class="period mono-num">
                {lang === 'ko' ? e.period_ko || e.period : e.period}
              </span>
              <strong>{pick(e, 'role', lang)}</strong>
              <span class="where">{pick(e, 'place', lang)}</span>
              <span class="note">{i === 0 ? labName : pick(e, 'note', lang)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 2. Education -->
    <section class="cv-sec">
      <h2>{t('cv.education')}</h2>
      <ul class="entries">
        {
          pi.education.map((e) => (
            <li>
              <span class="period mono-num">{e.period}</span>
              <strong>{pick(e, 'role', lang)}</strong>
              <span class="where">{pick(e, 'place', lang)}</span>
              {(e.note_en || e.note_ko) && <span class="note">{pick(e, 'note', lang)}</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 3. Research Interests -->
    <section class="cv-sec">
      <h2>{t('cv.interests')}</h2>
      <ul class="bullets">
        {cv.research_interests.map((r) => <li>{r[lang]}</li>)}
      </ul>
      <dl class="skills">
        {
          cv.skills.map((s) => (
            <>
              <dt>{pick(s, 'label', lang)}</dt>
              <dd>{pick(s, 'value', lang)}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <!-- 4. Publications -->
    <section class="cv-sec">
      <h2>{t('cv.publications')}</h2>

      {
        unpublished.length > 0 && (
          <div class="year-block">
            <h3>{t('cv.in_preparation')}</h3>
            <ul class="pubs" lang="en">
              {unpublished.map((p) => (
                <li class="no-num">
                  <span class="pub-body">
                    <Authors authors={p.authors} />
                    <span class="pub-title">, “{p.title}”</span>
                    <span class="pub-meta">
                      {' '}
                      ({t(`pub.${String(p.status).replace(/-/g, '_')}`)})
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        groups.map((g) => (
          <div class="year-block">
            <h3 class="mono-num">{g.year}</h3>
            <ul class="pubs" lang="en">
              {g.items.map((p) => (
                <li>
                  <span class="num mono-num">{p.id}.</span>
                  <span class="pub-body">
                    <Authors authors={p.authors} />
                    <span class="pub-title">, “{p.title},”</span>
                    <span class="pub-meta">
                      {' '}
                      <i>{p.venue}</i>
                      {p.detail && `, ${p.detail}`}
                      {p.year && `, ${p.year}`}
                    </span>
                    {(p.doi || p.metrics) && (
                      <span class="pub-extra">
                        {p.doi && (
                          <a href={doiUrl(p.doi)} target="_blank" rel="noopener">
                            DOI {p.doi}
                          </a>
                        )}
                        {p.doi && p.metrics && (
                          <span class="dot" aria-hidden="true">
                            ·
                          </span>
                        )}
                        {p.metrics && <span>{p.metrics}</span>}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- 5. Grants & Funded Projects -->
    <section class="cv-sec">
      <h2>{t('cv.grants')}</h2>

      <h3>{t('cv.grants_pi')}</h3>
      <ul class="entries">
        {
          piProjects.map((p) => (
            <li>
              <span class="period mono-num">{p.period}</span>
              <strong>{pick(p, 'title', lang)}</strong>
              {p.funder_en && <span class="where">{pick(p, 'funder', lang)}</span>}
              <span class="note">{t('cv.role_pi')}</span>
            </li>
          ))
        }
      </ul>

      <h3>{t('cv.grants_past')}</h3>
      <ul class="entries">
        {
          coProjects.map((p) => (
            <li>
              <span class="period mono-num">{p.period}</span>
              <strong>{pick(p, 'title', lang)}</strong>
              {p.funder_en && <span class="where">{pick(p, 'funder', lang)}</span>}
              <span class="note">{t('research.role_researcher')}</span>
            </li>
          ))
        }
        {
          cv.past_projects.map((p) => (
            <li>
              <span class="period mono-num">{p.period}</span>
              <strong>{pick(p, 'title', lang)}</strong>
              <span class="where">{pick(p, 'funder', lang)}</span>
              <span class="note">{pick(p, 'role', lang)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 6. Teaching -->
    <section class="cv-sec">
      <h2>{t('cv.teaching')}</h2>
      <ul class="entries">
        {
          lectures.semesters.map((s) => (
            <li>
              <span class="period mono-num">{s.id}</span>
              <strong>{pick(s, 'term', lang)}</strong>
              <span class="where">
                {s.courses.map((c, i) => (
                  <>
                    {i > 0 && ' · '}
                    {pick(c, 'title', lang)}
                    <span class="lvl"> ({levelLabel(c.level)})</span>
                  </>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 7. Patents -->
    <section class="cv-sec">
      <h2>{t('cv.patents')}</h2>
      <ul class="pubs">
        {
          cv.patents.map((p) => (
            <li>
              <span class="num mono-num">{p.no}.</span>
              <span class="pub-body">
                <span lang={nameLang(p)}>{p.inventors}</span>
                <span class="pub-title">, “{pick(p, 'title', lang)},”</span>
                <span class="pub-meta">
                  {' '}
                  <span class="mono-num">{p.number}</span>, {p.date} (
                  {pick(p, 'country', lang)}) — {t(`cv.patent_${p.status}`)}
                  {p.assignee_en && <>, {pick(p, 'assignee', lang)}</>}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 8. Conference Presentations -->
    <section class="cv-sec">
      <h2>{t('cv.conferences')}</h2>
      {
        [
          { label: t('pub.international'), list: international },
          { label: t('pub.domestic'), list: domestic },
        ].map((block) => (
          <div class="year-block">
            <h3>{block.label}</h3>
            <ul class="pubs" lang="en">
              {block.list.map((c, i) => (
                <li>
                  <span class="num mono-num">{block.list.length - i}.</span>
                  <span class="pub-body">
                    <Authors authors={c.authors} />
                    <span class="pub-title">, “{c.title},”</span>
                    <span class="pub-meta">
                      {' '}
                      <i>{c.venue}</i>
                      {c.place && `, ${c.place}`}
                      {c.date && `, ${c.date}`}
                      {` (${c.format === 'oral' ? t('pub.oral') : t('pub.poster')})`}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- 9. Honors & Awards -->
    <section class="cv-sec">
      <h2>{t('cv.awards')}</h2>
      <ul class="entries">
        {
          pi.awards.map((a) => (
            <li>
              <span class="period mono-num">
                {lang === 'ko' ? a.year_ko || a.year : a.year}
              </span>
              <strong>{pick(a, 'title', lang)}</strong>
              <span class="where">{pick(a, 'org', lang)}</span>
              {(a.advisee_en || a.advisee_ko) && (
                <span class="note">{pick(a, 'advisee', lang)}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</article>

<style>
  .cv-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(1100px 340px at 8% -30%, #eef3fd 0%, rgba(238, 243, 253, 0) 70%),
      var(--page);
  }
  .cv-head h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.4rem;
  }
  .role {
    font-size: 1.02rem;
    font-weight: 550;
    color: var(--accent);
    margin: 0 0 0.7rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    font-size: 0.885rem;
    color: var(--body);
  }
  .actions {
    margin: 1.5rem 0 0;
  }

  /* 1140px 폭에서는 한 줄이 110자를 넘어 눈이 다음 줄을 놓친다.
     이력서는 읽는 문서이므로 좁은 폭을 쓴다. */
  .cv-head .container,
  .body {
    max-width: var(--container-narrow);
  }
  .body {
    padding-block: clamp(2.25rem, 5vw, 3.25rem);
  }

  /* 섹션 제목은 작은 대문자 라벨이라, 구분선에 붙으면 선에 눌려 보인다.
     선과 제목 사이(padding-top)를 넉넉히 두고 모든 섹션에 같은 값을 쓴다. */
  .cv-sec {
    padding-top: clamp(2.6rem, 4vw, 3.4rem);
    margin-top: clamp(1.6rem, 2.5vw, 2.1rem);
    border-top: 1px solid var(--line);
  }
  .cv-sec:first-child {
    margin-top: 0;
    border-top: 0;
  }
  .cv-sec > h2 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  /* 목록을 끊어 주는 표지라 눈에 띄어야 한다. 연도든 "As Principal
     Investigator" 든 같은 위계이므로 같은 모양으로 둔다. */
  .cv-sec h3 {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin: 1.6rem 0 0.1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  .cv-sec h3:first-of-type {
    margin-top: 0;
  }

  .entries {
    display: grid;
    gap: 1rem;
  }
  .entries li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    grid-auto-flow: row;
    gap: 0.1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .entries li > :not(.period) {
    grid-column: 2;
  }
  .entries .period {
    grid-column: 1;
    grid-row: 1 / -1;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }
  .entries strong {
    font-weight: 620;
    color: var(--ink);
  }
  .where {
    color: var(--body);
  }
  .note {
    color: var(--muted);
    font-size: 0.83rem;
  }
  .lvl {
    color: var(--muted);
  }

  .bullets {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }

  .skills {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.88rem;
  }
  .skills dt {
    font-weight: 620;
    color: var(--ink);
  }
  .skills dd {
    margin: 0;
    color: var(--body);
  }

  /* 논문 목록은 한 항목이 서너 줄씩 되므로, 항목 사이 여백만으로는 경계가
     보이지 않는다. 가는 선으로 끊어 준다 (논문 페이지와 같은 방식). */
  .pubs {
    display: grid;
  }
  .pubs li {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.62;
  }
  .pubs li:last-child {
    border-bottom: 0;
  }
  .pubs li.no-num {
    grid-template-columns: minmax(0, 1fr);
  }
  .pubs .num {
    color: var(--muted);
    font-weight: 600;
    text-align: right;
  }
  .pub-title {
    color: var(--ink);
    font-weight: 550;
  }
  .pub-meta {
    color: var(--muted);
  }
  .pub-meta i {
    font-style: italic;
    color: var(--body);
  }
  /* DOI·피인용 지표는 인용 문장에 섞이면 읽는 흐름을 끊는다. 아랫줄로 뺀다. */
  .pub-extra {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.785rem;
    color: var(--muted);
  }
  .pub-extra .dot {
    margin: 0 0.4rem;
    color: var(--line);
  }

  .year-block + .year-block {
    margin-top: 1.6rem;
  }
  .year-block > h3 {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .entries li,
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
    .entries .period {
      grid-row: auto;
    }
  }

  /* ── 인쇄 / PDF ─────────────────────────────────────────────────
     화면용 크기는 rem, 인쇄용은 pt 로 다시 정한다. 둘을 섞으면 rem 로 적힌
     하위 요소(.note 등)가 pt 로 줄인 부모보다 커져서 위계가 뒤집힌다. */
  @media print {
    .actions {
      display: none;
    }

    .body {
      padding-block: 0;
      font-size: 9.2pt;
    }
    .cv-head .container,
    .body {
      max-width: none;
    }

    /* 머리말 */
    .cv-head {
      background: none;
      padding-block: 0 0.9rem;
    }
    .cv-head h1 {
      font-size: 21pt;
      margin-bottom: 0.25rem;
    }
    .role {
      font-size: 10pt;
      margin-bottom: 0.45rem;
    }
    .contact {
      font-size: 8.5pt;
      gap: 0.1rem 0.9rem;
    }

    /* 섹션. 한 섹션을 통째로 다음 장에 밀면 앞장 아래가 크게 비므로,
       제목이 혼자 남는 것만 막고 내용은 이어지게 둔다. */
    .cv-sec {
      padding-top: 1.85rem;
      margin-top: 1.05rem;
    }
    .cv-sec:first-child {
      padding-top: 1.35rem;
    }
    .cv-sec > h2 {
      font-size: 8pt;
      margin-bottom: 0.6rem;
      break-after: avoid-page;
    }
    .cv-sec h3 {
      font-size: 9.4pt;
      margin: 1.1rem 0 0.1rem;
      padding-bottom: 0.25rem;
      break-after: avoid-page;
    }
    .pubs li,
    .entries li {
      break-inside: avoid;
    }

    /* 경력·학력·과제·강의 */
    .entries {
      gap: 0.6rem;
    }
    .entries li {
      grid-template-columns: 7.4rem minmax(0, 1fr);
      gap: 0.04rem 0.9rem;
      font-size: 9.2pt;
      line-height: 1.45;
    }
    .entries .period {
      font-size: 8.4pt;
    }
    .where {
      font-size: 8.8pt;
    }
    .note,
    .lvl {
      font-size: 8.6pt;
    }

    /* 논문·특허·학회. 화면과 마찬가지로 가는 선으로 항목을 끊는다. */
    .pubs li {
      padding: 0.34rem 0;
      border-bottom: 1px solid #eef1f7;
      font-size: 8.9pt;
      line-height: 1.45;
    }
    .pub-extra {
      margin-top: 0.04rem;
      font-size: 8.1pt;
    }

    .bullets {
      margin-bottom: 1rem;
    }
    /* 인쇄에서는 배경색이 찍히지 않아 글머리 점이 사라진다.
       테두리로 그리면 그대로 남는다. */
    .bullets li::before {
      width: 0;
      height: 0;
      border: 2.5px solid var(--accent);
      background: none;
    }
    .bullets li {
      font-size: 9pt;
      line-height: 1.45;
    }
    .skills {
      grid-template-columns: 7.4rem minmax(0, 1fr);
      gap: 0.3rem 0.9rem;
      font-size: 9pt;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
