---
import PiIdentity from '../PiIdentity.astro';
import Authors from '../Authors.astro';
import {
  fullAddress,
  site,
  members,
  cv,
  lectures,
  journalsByYear,
  conferencesByScope,
  projectsInOrder,
  academicService,
  awardsInOrder,
  doiUrl,
} from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pi = members.pi;
const office = site.contact.office;
// 준비 중·심사 중 원고는 Full CV 에 싣지 않는다 (Publications 페이지에는 그대로 있다).
const { groups } = journalsByYear();
const { international, domestic } = conferencesByScope();

// 과제는 어디서 왔든 같은 두 줄 구조로 그린다.
//   1줄: 제목 + 역할 배지 / 2줄: 지원기관 · 기간
const grantRow = (g, isPi) => ({
  title: pick(g, 'title', lang),
  funder: g.funder_en ? pick(g, 'funder', lang) : '',
  period: g.period,
  isPi,
});
const piGrants = projectsInOrder()
  .filter((g) => g.role === 'pi')
  .map((g) => grantRow(g, true));
const otherGrants = [
  ...projectsInOrder()
    .filter((g) => g.role !== 'pi')
    .map((g) => grantRow(g, false)),
  ...cv.past_projects.map((g) => grantRow(g, false)),
];

// 특허 발명자 중 본인 이름은 논문과 마찬가지로 굵게 표시한다.
const LAB = (site.lab_authors ?? []).map((n) => n.toLowerCase());
const inventorList = (text) =>
  String(text ?? '')
    .split(/,\s*/)
    .map((n) => ({ name: n, isLab: LAB.includes(n.toLowerCase()) }));

// 학술 경력의 첫 항목(현직)에는 연구실 이름을 함께 적는다.
const labName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
const officeAddress = fullAddress(office, lang);
const levelLabel = (level) =>
  level === 'graduate' ? t('lectures.graduate') : t('lectures.undergraduate');

// 발명자명이 한글이면 lang="ko" 로 표시한다 (한국 특허는 국문 등재명을 그대로 쓴다).
const nameLang = (p) => (/[가-힣]/.test(p.inventors) ? 'ko' : 'en');

---

<article class="cv">
  <header class="cv-head">
    <div class="container">
      <PiIdentity size="lg" level={1} />
      <p class="contact">
        <span>{officeAddress}</span>
        <span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></span>
        <span><a href={`tel:${office.phone}`}>{office.phone_display}</a></span>
        {pi.scholar_url && (
          <span><a href={pi.scholar_url} target="_blank" rel="noopener">Google Scholar</a></span>
        )}
        {pi.orcid && (
          <span>
            <a href={`https://orcid.org/${pi.orcid}`} target="_blank" rel="noopener">
              ORCID <span class="mono-num">{pi.orcid}</span>
            </a>
          </span>
        )}
      </p>
      <p class="actions">
        <a class="btn btn-primary" href="/cv-full.pdf" download>{t('cv.download_full')}</a>
        <a class="btn btn-ghost" href={localizePath('/cv/short', lang)}>{t('cv.short_title')}</a>
      </p>
    </div>
  </header>

  <div class="container body">
    <!-- 1. Academic Appointments -->
    <section class="cv-sec">
      <h2>{t('cv.appointments')}</h2>
      <ul class="entries">
        {
          pi.experience.map((e, i) => (
            <li>
              <span class="period mono-num">
                {lang === 'ko' ? e.period_ko || e.period : e.period}
              </span>
              <strong>{pick(e, 'role', lang)}</strong>
              <span class="where">{pick(e, 'place', lang)}</span>
              <span class="note">{i === 0 ? labName : pick(e, 'note', lang)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 2. Education -->
    <section class="cv-sec">
      <h2>{t('cv.education')}</h2>
      <ul class="entries">
        {
          pi.education.map((e) => (
            <li>
              <span class="period mono-num">{e.period}</span>
              <strong>{pick(e, 'role', lang)}</strong>
              <span class="where">{pick(e, 'place', lang)}</span>
              {(e.note_en || e.note_ko) && <span class="note">{pick(e, 'note', lang)}</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 3. Research Interests -->
    <section class="cv-sec">
      <h2>{t('cv.interests')}</h2>
      <ul class="bullets">
        {cv.research_interests.map((r) => <li>{r[lang]}</li>)}
      </ul>
    </section>

    <!-- 3b. Skills -->
    <section class="cv-sec">
      <h2>{t('cv.skills')}</h2>
      <dl class="skills">
        {
          cv.skills.map((sk) => (
            <>
              <dt>{pick(sk, 'label', lang)}</dt>
              <dd>{pick(sk, 'value', lang)}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <!-- 4. Publications -->
    <section class="cv-sec">
      <h2>{t('cv.publications')}</h2>

      {
        groups.map((g) => (
          <div class="year-block">
            <h3 class="mono-num">{g.year}</h3>
            <ul class="pubs" lang="en">
              {g.items.map((p) => (
                <li>
                  <span class="num mono-num">{p.id}.</span>
                  <span class="pub-body">
                    <Authors authors={p.authors} />
                    <span class="pub-title">, “{p.title},”</span>
                    <span class="pub-meta">
                      {' '}
                      <i>{p.venue}</i>
                      {p.detail && `, ${p.detail}`}
                      {p.year && `, ${p.year}`}
                    </span>
                    {(p.doi || p.metrics) && (
                      <span class="pub-extra">
                        {p.doi && (
                          <a href={doiUrl(p.doi)} target="_blank" rel="noopener">
                            doi.org/{p.doi}
                          </a>
                        )}
                        {p.doi && p.metrics && (
                          <span class="dot" aria-hidden="true">
                            ·
                          </span>
                        )}
                        {p.metrics && <span>{p.metrics}</span>}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- 5. Grants & Funded Projects -->
    <section class="cv-sec">
      <h2>{t('cv.grants')}</h2>

      <h3>{t('cv.grants_pi')}</h3>
      <ul class="grants">
        {
          piGrants.map((g) => (
            <li>
              <span class="g-title">
                <strong>{g.title}</strong>
                <span class="g-badge pi">PI</span>
              </span>
              <span class="g-meta">
                {g.funder && <>{g.funder} · </>}
                <span class="mono-num">{g.period}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <h3>{t('cv.grants_past')}</h3>
      <ul class="grants">
        {
          otherGrants.map((g) => (
            <li>
              <span class="g-title">
                <strong>{g.title}</strong>
                <span class="g-badge">Researcher</span>
              </span>
              <span class="g-meta">
                {g.funder && <>{g.funder} · </>}
                <span class="mono-num">{g.period}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 5b. Academic Service -->
    <section class="cv-sec">
      <h2>{t('cv.service')}</h2>
      <ul class="entries">
        {
          academicService().map((e) => (
            <li>
              <span class="period mono-num">
                {lang === 'ko' ? e.period_ko || e.period : e.period}
              </span>
              <strong>{pick(e, 'role', lang)}</strong>
              <span class="where">{pick(e, 'org', lang)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 6. Teaching -->
    <section class="cv-sec">
      <h2>{t('cv.teaching')}</h2>
      <ul class="entries">
        {
          lectures.semesters.map((s) => (
            <li>
              <span class="period mono-num">{s.id}</span>
              <strong>{pick(s, 'term', lang)}</strong>
              <span class="where">
                {s.courses.map((c, i) => (
                  <>
                    {i > 0 && ' · '}
                    {pick(c, 'title', lang)}
                    <span class="lvl"> ({levelLabel(c.level)})</span>
                  </>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 7. Patents -->
    <section class="cv-sec">
      <h2>{t('cv.patents')}</h2>
      <ul class="pubs">
        {
          cv.patents.map((p) => (
            <li>
              <span class="num mono-num">{p.no}.</span>
              <span class="pub-body">
                <span lang={nameLang(p)}>
                  {inventorList(p.inventors).map((inv, i) => (
                    <>
                      {i > 0 && ', '}
                      {inv.isLab ? <strong class="author-lab">{inv.name}</strong> : inv.name}
                    </>
                  ))}
                </span>
                {/* 특허 제목은 두 언어 페이지 모두 등록된 영문 명칭으로 통일한다. */}
                <span class="pub-title">, “{p.title_en},”</span>
                <span class="pub-extra">
                  <span class="mono-num">
                    {p.country_code} {p.number}
                  </span>
                  <span class="dot" aria-hidden="true">
                    ·
                  </span>
                  <span class="mono-num">{p.date}</span>
                  <span class="dot" aria-hidden="true">
                    ·
                  </span>
                  {t(`cv.patent_${p.status}`)}
                  {p.assignee_en && (
                    <>
                      <span class="dot" aria-hidden="true">
                        ·
                      </span>
                      {pick(p, 'assignee', lang)}
                    </>
                  )}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 8. Conference Presentations -->
    <section class="cv-sec">
      <h2>{t('cv.conferences')}</h2>
      {
        [
          { label: t('pub.international'), list: international },
          { label: t('pub.domestic'), list: domestic },
        ].map((block) => (
          <div class="year-block">
            <h3>{block.label}</h3>
            <ul class="pubs" lang="en">
              {block.list.map((c, i) => (
                <li>
                  <span class="num mono-num">{block.list.length - i}.</span>
                  <span class="pub-body">
                    <Authors authors={c.authors} />
                    <span class="pub-title">, “{c.title},”</span>
                    <span class="pub-meta">
                      {' '}
                      <i>{c.venue}</i>
                      {c.place && `, ${c.place}`}
                      {c.date && `, ${c.date}`}
                      {` (${c.format === 'oral' ? t('pub.oral') : t('pub.poster')})`}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- 9. Honors & Awards -->
    <section class="cv-sec">
      <h2>{t('cv.awards')}</h2>
      <ul class="entries">
        {
          awardsInOrder().map((a) => (
            <li>
              <span class="period mono-num">
                {lang === 'ko' ? a.year_ko || a.year : a.year}
              </span>
              <strong>{pick(a, 'title', lang)}</strong>
              <span class="where">{pick(a, 'org', lang)}</span>
              {(a.advisee_en || a.advisee_ko) && (
                <span class="note">{pick(a, 'advisee', lang)}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</article>

<style>
  .cv-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(1100px 340px at 8% -30%, #eef3fd 0%, rgba(238, 243, 253, 0) 70%),
      var(--page);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    font-size: 0.885rem;
    color: var(--muted);
  }
  .actions {
    margin: 1.5rem 0 0;
  }

  /* 1140px 폭에서는 한 줄이 110자를 넘어 눈이 다음 줄을 놓친다.
     이력서는 읽는 문서이므로 좁은 폭을 쓴다. */
  .cv-head .container,
  .body {
    max-width: var(--container-narrow);
  }
  .body {
    padding-block: clamp(2.25rem, 5vw, 3.25rem);
  }

  /* 섹션 제목은 작은 대문자 라벨이라, 구분선에 붙으면 선에 눌려 보인다.
     선과 제목 사이(padding-top)를 넉넉히 두고 모든 섹션에 같은 값을 쓴다. */
  .cv-sec {
    padding-top: clamp(2.6rem, 4vw, 3.4rem);
    margin-top: clamp(1.6rem, 2.5vw, 2.1rem);
    border-top: 1px solid var(--line);
  }
  .cv-sec:first-child {
    margin-top: 0;
    border-top: 0;
  }
  .cv-sec > h2 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  /* 목록을 끊어 주는 표지라 눈에 띄어야 한다. 연도든 "As Principal
     Investigator" 든 같은 위계이므로 같은 모양으로 둔다. */
  .cv-sec h3 {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin: 1.6rem 0 0.1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  .cv-sec h3:first-of-type {
    margin-top: 0;
  }

  .entries {
    display: grid;
    gap: 1rem;
  }
  .entries li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    grid-auto-flow: row;
    gap: 0.1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .entries li > :not(.period) {
    grid-column: 2;
  }
  .entries .period {
    grid-column: 1;
    grid-row: 1 / -1;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }
  .entries strong {
    font-weight: 620;
    color: var(--ink);
  }
  .where {
    color: var(--body);
  }
  .note {
    color: var(--muted);
    font-size: 0.83rem;
  }
  .lvl {
    color: var(--muted);
  }

  /* 과제는 두 줄로 읽는다: 제목+역할, 그리고 지원기관·기간.
     항목 안은 촘촘하게, 항목 사이는 넉넉하게 — 값을 하나로 고정한다. */
  .grants {
    display: grid;
    gap: 0.85rem;
  }
  .grants li {
    display: grid;
    gap: 0.12rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .g-title strong {
    font-weight: 620;
    color: var(--ink);
  }
  .g-badge {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.02rem 0.42rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    vertical-align: 0.12em;
    white-space: nowrap;
  }
  .g-badge.pi {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  .g-meta {
    font-size: 0.845rem;
    color: var(--muted);
  }

  .bullets {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }

  .skills {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.88rem;
  }
  .skills dt {
    font-weight: 620;
    color: var(--ink);
  }
  .skills dd {
    margin: 0;
    color: var(--body);
  }

  /* 논문 목록은 한 항목이 서너 줄씩 되므로, 항목 사이 여백만으로는 경계가
     보이지 않는다. 가는 선으로 끊어 준다 (논문 페이지와 같은 방식). */
  .pubs {
    display: grid;
  }
  .pubs li {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.62;
  }
  .pubs li:last-child {
    border-bottom: 0;
  }
  .pubs li.no-num {
    grid-template-columns: minmax(0, 1fr);
  }
  .pubs .num {
    color: var(--muted);
    font-weight: 600;
    text-align: right;
  }
  .pub-title {
    color: var(--ink);
    font-weight: 550;
  }
  .pub-meta {
    color: var(--muted);
  }
  .pub-meta i {
    font-style: italic;
    color: var(--body);
  }
  /* DOI·피인용 지표는 인용 문장에 섞이면 읽는 흐름을 끊는다. 아랫줄로 뺀다. */
  .pub-extra {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.785rem;
    color: var(--muted);
  }
  .pub-extra .dot {
    margin: 0 0.4rem;
    color: var(--line);
  }

  .year-block + .year-block {
    margin-top: 1.6rem;
  }
  .year-block > h3 {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .entries li,
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
    .entries .period {
      grid-row: auto;
    }
  }

  /* ── 인쇄 / PDF ─────────────────────────────────────────────────
     화면용 크기는 rem, 인쇄용은 pt 로 다시 정한다. 둘을 섞으면 rem 로 적힌
</style>
