---
import PageHero from '../PageHero.astro';
import Authors from '../Authors.astro';
import { publications, cv, conferencesByScope } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { international, domestic } = conferencesByScope();
const journalCount = publications.journals.length;
const conferenceCount = publications.conferences.length;
const patentCount = cv.patents.length;
---

<PageHero kicker={t('page.kicker.publications')} title={t('pub.conferences')}>
  <p class="counts">
    <span class="count-chip">
      <strong class="mono-num">{conferenceCount}</strong> {t('pub.count_conferences')}
    </span>
    <a class="count-chip link" href={localizePath('/publications/journal', lang)}>
      <strong class="mono-num">{journalCount}</strong> {t('pub.count_journals')} →
    </a>
    <a class="count-chip link" href={localizePath('/publications/patent', lang)}>
      <strong class="mono-num">{patentCount}</strong> {t('pub.count_patents')} →
    </a>
  </p>
  <p class="legend small muted">{t('pub.legend')}</p>
</PageHero>

{
  [
    { id: 'international', label: t('pub.international'), list: international },
    { id: 'domestic', label: t('pub.domestic'), list: domestic },
  ].map((block, bi) => (
    <section class:list={['section', { band: bi % 2 === 1 }]} id={block.id}>
      <div class="container">
        <h2 class="block-title">
          {block.label}
          <span class="count mono-num">{block.list.length}</span>
        </h2>
        <ol class="conf-list">
          {block.list.map((c, i) => (
            <li lang="en">
              <span class="num mono-num">{block.list.length - i}.</span>
              <div class="body">
                <h3 class="conf-title">{c.title}</h3>
                <p class="conf-authors">
                  <Authors authors={c.authors} />
                </p>
                <p class="conf-meta">
                  <em>{c.venue}</em>
                  {c.place && <span>, {c.place}</span>}
                  {c.date && <span>, {c.date}</span>}
                  <span class:list={['fmt', c.format]}>
                    {c.format === 'oral' ? t('pub.oral') : t('pub.poster')}
                  </span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))
}

<section class="section-tight">
  <div class="container">
    <p class="to-other">
      <a class="link-arrow" href={localizePath('/publications/journal', lang)}>
        {t('pub.journals')}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    margin: 0.9rem 0 0.75rem;
  }
  .count-chip {
    font-size: 0.9rem;
    color: var(--body);
  }
  .count-chip strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.25rem;
  }
  a.count-chip {
    text-decoration: none;
    color: var(--muted);
  }
  a.count-chip strong {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  a.count-chip:hover,
  a.count-chip:hover strong {
    color: var(--accent);
    text-decoration: none;
  }

  .legend {
    margin: 0;
    max-width: 60ch;
  }

  .band {
    background: #f6f8fc;
    border-block: 1px solid var(--line);
  }

  .block-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 1.25rem;
  }
  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .conf-list {
    display: grid;
  }
  .conf-list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    text-align: right;
    padding-top: 0.15rem;
  }

  .conf-title {
    font-family: var(--font-sans);
    margin: 0 0 0.3rem;
    font-size: 0.985rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }
  .conf-authors {
    margin: 0 0 0.25rem;
    font-size: 0.885rem;
  }
  .conf-meta {
    margin: 0;
    font-size: 0.865rem;
    color: var(--muted);
  }
  .conf-meta em {
    color: var(--body);
  }

  /* 구두 발표만 눈에 띄게. 포스터는 조용한 회색으로 둔다. */
  .fmt {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.42rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    vertical-align: 0.05em;
  }
  .fmt.oral {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .to-other {
    margin: 0;
  }

  @media (max-width: 560px) {
    .conf-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
    .num {
      text-align: left;
    }
  }
</style>
