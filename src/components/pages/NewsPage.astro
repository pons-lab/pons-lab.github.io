---
import { getCollection } from 'astro:content';
import PageHero from '../PageHero.astro';
import NewsItem from '../NewsItem.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = (await getCollection('news')).sort((a, b) => b.data.date - a.data.date);
---

<PageHero kicker={t('page.kicker.news')} title={t('news.title')} lead={t('news.lead')} />

<section class="section">
  <div class="container">
    {
      items.length ? (
        <ul class="news-list">
          {items.map((item) => (
            <NewsItem item={item} />
          ))}
        </ul>
      ) : (
        <p class="muted">{t('news.empty')}</p>
      )
    }

    <p class="to-gallery">
      <a class="link-arrow" href={localizePath('/gallery', lang)}>
        {t('news.see_gallery')}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .news-list {
    display: grid;
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }

  .to-gallery {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }
</style>
