---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageHero from '../PageHero.astro';
import NewsCard from '../NewsCard.astro';
import { gallery } from '../../lib/data.js';
import { galleryPhotos } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = (await getCollection('news')).sort((a, b) => b.data.date - a.data.date);

// 갤러리: yaml 의 순서대로, 각 행사 폴더에 든 사진을 모두 가져온다.
const events = gallery.events
  .map((e) => ({ ...e, photos: galleryPhotos(e.folder) }))
  .filter((e) => e.photos.length > 0);
---

<PageHero kicker={t('page.kicker.news')} title={t('news.title')} lead={t('news.lead')} />

<section class="section">
  <div class="container">
    {
      items.length ? (
        <div class="grid grid-3">
          {items.map((item) => (
            <NewsCard item={item} />
          ))}
        </div>
      ) : (
        <p class="muted">{t('news.empty')}</p>
      )
    }
  </div>
</section>

<!-- ── 갤러리 ────────────────────────────────────────────────────────── -->
<section class="section gallery-band" id="gallery">
  <div class="container">
    <h2 class="sec-title">{t('news.gallery')}</h2>
    <p class="sec-sub">{t('news.gallery_lead')}</p>

    <div class="events">
      {
        events.map((e) => (
          <section class="event">
            <h3 class="event-title">
              <span>{pick(e, 'title', lang)}</span>
              {e.date && <span class="event-date mono-num">{e.date.replace('-', '.')}</span>}
            </h3>
            <ul class="shots">
              {e.photos.map((photo, i) => (
                <li class="shot">
                  <Image
                    src={photo}
                    alt={`${pick(e, 'title', lang)} ${i + 1}`}
                    width={320}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-band {
    background: #f6f8fc;
    border-top: 1px solid var(--line);
  }

  .events {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
  }

  .event-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 650;
    color: var(--ink);
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .event-date {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    flex: none;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.75rem;
  }

  .shot {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
    aspect-ratio: 4 / 3;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .shot:hover :global(img) {
    transform: scale(1.04);
  }

  @media (max-width: 560px) {
    .shots {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.5rem;
    }
  }
</style>
