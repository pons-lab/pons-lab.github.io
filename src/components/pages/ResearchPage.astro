---
import PageHero from '../PageHero.astro';
import { projectsInOrder, research, paperById, doiUrl } from '../../lib/data.js';
import { asset } from '../../lib/images.js';

// SVG 다이어그램은 그대로 쓰고, 사진(jpg/png)이 들어오면 크기만 맞춘다.
const figure = (path) => asset(path)?.src ?? null;
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageHero
  kicker={t('page.kicker.research')}
  title={t('research.title')}
  lead={t('research.lead')}
/>

<section class="section">
  <div class="container axes">
    {
      research.axes.map((axis, i) => (
        <article class="axis">
          <header class="axis-head">
            <span class="num mono-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>{pick(axis, 'title', lang)}</h2>
              <p class="lead">{pick(axis, 'lead', lang)}</p>
            </div>
          </header>

          {figure(axis.image) && (
            <figure class="axis-figure">
              <img src={figure(axis.image)} alt={pick(axis, 'title', lang)} loading="lazy" />
            </figure>
          )}

          <div class="grid grid-3 topics">
            {axis.topics.map((topic) => (
              <div class="card topic">
                {figure(topic.image) && (
                  <figure class="topic-figure">
                    <img src={figure(topic.image)} alt={pick(topic, 'title', lang)} loading="lazy" />
                    {topic.image_credit && (
                      <figcaption lang="en">{topic.image_credit}</figcaption>
                    )}
                  </figure>
                )}
                <h3>{pick(topic, 'title', lang)}</h3>
                {(topic.text_en || topic.text_ko) && <p>{pick(topic, 'text', lang)}</p>}

                {topic.refs?.length && (
                  <ul class="refs" lang="en">
                    {topic.refs.map((id) => paperById(id)).filter(Boolean).map((paper) => (
                      <li>
                        {doiUrl(paper.doi) ? (
                          <a href={doiUrl(paper.doi)} target="_blank" rel="noopener">
                            {paper.venue} {paper.year}
                          </a>
                        ) : (
                          <span>
                            {paper.venue} {paper.year}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section projects-band">
  <div class="container">
    <div class="section-head">
      <h2>{t('research.projects')}</h2>
    </div>

    <ul class="projects">
      {
        projectsInOrder().map((p) => (
          <li class="card project">
            <span class="period mono-num">
              {p.period}
              <span class:list={['role', p.role]}>
                {p.role === 'pi' ? t('research.role_pi') : t('research.role_researcher')}
              </span>
            </span>
            <h3>{pick(p, 'title', lang)}</h3>
            <span class="tag">{pick(p, 'short', lang)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .axes {
    display: grid;
    gap: clamp(2.75rem, 6vw, 4.5rem);
  }

  .axis-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .num {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    line-height: 1;
    margin-top: 0.5rem;
  }

  .axis-head h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 0.5rem;
  }

  .axis-head .lead {
    margin-bottom: 0;
  }

  .axis-figure {
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #f4f7fd;
  }
  .axis-figure img {
    width: 100%;
    display: block;
  }

  .topic-figure {
    margin: calc(-1 * clamp(1.4rem, 2.4vw, 1.9rem)) calc(-1 * clamp(1.4rem, 2.4vw, 1.9rem)) 1.15rem;
    border-bottom: 1px solid var(--line);
    background: #f4f7fd;
  }
  .topic-figure img {
    width: 100%;
    display: block;
    aspect-ratio: 800 / 460;
    object-fit: cover;
  }

  /* 논문 도면을 가져다 쓴 경우 출처를 작게 밝힌다 */
  .topic-figure figcaption {
    padding: 0.45rem clamp(1.4rem, 2.4vw, 1.9rem) 0.5rem;
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--muted);
    background: var(--card);
    border-top: 1px solid var(--line);
  }

  .topic h3 {
    font-family: var(--font-sans);
    font-size: 0.99rem;
    font-weight: 620;
    margin-bottom: 0.5rem;
    letter-spacing: -0.008em;
  }

  /* 주제마다 근거가 되는 실제 논문을 저널명 + 연도 칩으로 보여준다. */
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .refs li {
    font-size: 0.745rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .refs a,
  .refs span {
    display: inline-block;
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    text-decoration: none;
  }
  .refs a:hover {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }

  .topic {
    display: flex;
    flex-direction: column;
  }
  .topic p {
    flex: 1;
    margin: 0;
    font-size: 0.9rem;
    color: var(--body);
    line-height: 1.62;
  }

  .projects-band {
    background: #f6f8fc;
    border-top: 1px solid var(--line);
  }

  .projects {
    display: grid;
    gap: 0.9rem;
  }

  .project {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  /* 연구책임자 / 참여연구원 구분 */
  .role {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  .role.pi {
    background: var(--accent);
    color: #fff;
  }
  .role.researcher {
    background: #eef2f9;
    color: var(--body);
  }

  .project h3 {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
    max-width: 72ch;
  }
</style>
