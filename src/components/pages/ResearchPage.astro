---
import PageHero from '../PageHero.astro';
import { projectsInOrder, research, paperById, doiUrl } from '../../lib/data.js';
import { asset } from '../../lib/images.js';

// SVG 다이어그램은 그대로 쓰고, 사진(jpg/png)이 들어오면 크기만 맞춘다.
const figure = (path) => asset(path)?.src ?? null;
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageHero
  kicker={t('page.kicker.research')}
  title={t('research.title')}
  lead={t('research.lead')}
/>

<section class="section">
  <div class="container axes">
    {
      research.axes.map((axis) => (
        <article class="axis">
          <header class="axis-head">
            <h2>{pick(axis, 'title', lang)}</h2>
            <p class="lead">{pick(axis, 'lead', lang)}</p>
          </header>

          {figure(axis.image) && (
            <figure class="axis-figure">
              <img src={figure(axis.image)} alt={pick(axis, 'title', lang)} loading="lazy" />
            </figure>
          )}

          <div class="grid grid-3 topics">
            {axis.topics.map((topic) => (
              <div class="card topic">
                {figure(topic.image) && (
                  <figure class="topic-figure">
                    <img src={figure(topic.image)} alt={pick(topic, 'title', lang)} loading="lazy" />
                    {topic.image_credit && (
                      <figcaption lang="en">{topic.image_credit}</figcaption>
                    )}
                  </figure>
                )}
                <h3>{pick(topic, 'title', lang)}</h3>
                {(topic.text_en || topic.text_ko) && <p>{pick(topic, 'text', lang)}</p>}

                {topic.refs?.length && (
                  <ul class="refs" lang="en">
                    {topic.refs.map((id) => paperById(id)).filter((p) => p?.venue).map((paper) => (
                      <li>
                        {doiUrl(paper.doi) ? (
                          <a href={doiUrl(paper.doi)} target="_blank" rel="noopener">
                            {paper.venue} {paper.year}
                          </a>
                        ) : (
                          <span>
                            {paper.venue} {paper.year}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section projects-band">
  <div class="container">
    <div class="section-head">
      <h2>{t('research.projects')}</h2>
    </div>

    <ul class="projects">
      {
        projectsInOrder().map((p) => (
          <li class="card project">
            <span class="period mono-num">
              {p.period}
              <span class:list={['role', p.role]}>
                {p.role === 'pi' ? t('research.role_pi') : t('research.role_researcher')}
              </span>
            </span>
            <h3>{pick(p, 'title', lang)}</h3>
            <span class="t-tag">{pick(p, 'short', lang)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .axes {
    display: grid;
    gap: clamp(2.75rem, 6vw, 4.5rem);
  }

  .axis-head {
    margin-bottom: 2.25rem;
  }

  .axis-head h2 {
    font-size: var(--text-h2);
    margin-bottom: 0.5rem;
  }

  .axis-head .lead {
    margin-bottom: 0;
  }

  .axis-figure {
    margin: 0 0 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
  }
  .axis-figure img {
    width: 100%;
    display: block;
  }

  .topic-figure {
    margin: -1.5rem -1.5rem 1.25rem;
    background: var(--surface-2);
  }
  .topic-figure img {
    width: 100%;
    display: block;
    aspect-ratio: 800 / 460;
    object-fit: cover;
  }

  /* 논문 도면을 가져다 쓴 경우 출처를 작게 밝힌다 */
  .topic-figure figcaption {
    padding: 0.5rem 1.5rem;
    font-size: var(--text-3xs);
    line-height: 1.4;
    color: var(--muted);
    background: var(--surface-2);
  }

  .topic h3 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  /* 주제마다 근거가 되는 실제 논문을 저널명 + 연도 칩으로 보여준다. */
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .refs li {
    font-size: var(--text-2xs);
    font-weight: 600;
    line-height: 1.35;
  }
  .refs a,
  .refs span {
    display: inline-block;
    padding: 0.24rem 0.55rem;
    border-radius: 8px;
    background: var(--bg);
    color: var(--text-4);
    text-decoration: none;
    transition: color 0.2s;
  }
  .refs a:hover {
    color: var(--accent-fg);
    text-decoration: none;
  }

  .topic {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* 본문을 늘려 칩을 카드 바닥에 붙이지 않는다. 설명이 짧은 카드에서
     글과 칩 사이가 뻥 뚫려 보이고, 칩 위 구분선이 카드마다 다른 높이에
     걸린다. 남는 자리는 카드 아래쪽에 두는 편이 훨씬 덜 튄다. */
  .topic p {
    margin: 0;
    font-size: var(--text-md);
    color: var(--body);
    line-height: 1.62;
  }

  .projects-band {
    background: var(--bg);
  }

  .projects {
    display: grid;
    gap: 0.9rem;
  }

  .project {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-4);
  }

  /* 연구책임자 / 참여연구원 구분 */
  .role {
    padding: 0.1rem 0.5rem;
    border-radius: 8px;
    font-size: var(--text-3xs);
    font-weight: 600;
  }
  .role.pi {
    background: var(--accent-weak);
    color: var(--accent-fg);
  }
  .role.researcher {
    background: var(--bg);
    color: var(--body);
  }

  .project h3 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
    max-width: 72ch;
  }
</style>
