---
import ServiceIcon from '../ServiceIcon.astro';
import Affiliation from '../Affiliation.astro';
import PageHero from '../PageHero.astro';
import Address from '../Address.astro';
import { site, members } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const lab = site.contact.lab;
const office = site.contact.office;
const labRoom = lang === 'ko' ? lab.room_ko : lab.room_en;
const officeRoom = lang === 'ko' ? office.room_ko : office.room_en;
const how = lang === 'ko' ? site.recruiting.how_to_apply_ko : site.recruiting.how_to_apply_en;
---

<PageHero kicker={t('page.kicker.contact')} title={t('contact.title')} lead={t('contact.lead')} />

<section class="section">
  <div class="container layout">
    <div class="info">
      <dl class="rows">
        <div class="row">
          <dt><ServiceIcon name="pin" size={18} />{t('contact.lab')}</dt>
          <dd>
            <p class="strongish">{labRoom}</p>
            <p><Address place={lab} /></p>
            {lab.phone && (
              <p><a href={`tel:${lab.phone}`}>{lab.phone_display}</a></p>
            )}
            <p class="muted small"><Affiliation /></p>
            <p class="map">
              <a
                class="link-arrow"
                href={site.contact.map_url}
                target="_blank"
                rel="noopener"
              >
                <ServiceIcon name="maps" size={18} />
                {t('contact.map')}
              </a>
            </p>
          </dd>
        </div>

        <div class="row">
          <dt><ServiceIcon name="mail" size={18} />{t('contact.email')}</dt>
          <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        </div>

        <div class="row">
          <dt><ServiceIcon name="building" size={18} />{t('contact.office')}</dt>
          <dd>
            <p class="strongish">{officeRoom}</p>
            <p><Address place={office} /></p>
            <p><a href={`tel:${office.phone}`}>{office.phone_display}</a></p>
          </dd>
        </div>
      </dl>
    </div>

    <aside class="join card">
      <h2>{t('contact.join_title')}</h2>
      <p>{site.recruiting[lang]}</p>
      <p class="muted">{how}</p>
      <a class="t-btn t-btn--primary" href={`mailto:${site.contact.email}`}>{t('cta.email')}</a>
    </aside>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: start;
  }

  .rows {
    margin: 0;
    display: grid;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 9rem) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 0;
  }
  .row:first-child {
    padding-top: 0;
  }

  dt {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--muted);
  }
  dt :global(.svc-icon) {
    margin-top: 0.15em;
  }

  dd {
    margin: 0;
    font-size: var(--text-lg);
  }
  dd p {
    margin: 0 0 0.28rem;
  }
  dd p:last-child {
    margin-bottom: 0;
  }

  .strongish {
    font-weight: 600;
    color: var(--ink);
  }

  .map {
    margin-top: 0.6rem !important;
  }

  .join {
  }

  .join h2 {
    font-size: var(--text-2xl);
    margin-bottom: 0.7rem;
  }

  .join p {
    font-size: var(--text-lg);
    margin-bottom: 0.7rem;
  }

  .join .t-btn {
    margin-top: 0.6rem;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
