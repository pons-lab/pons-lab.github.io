---
import { Image } from 'astro:assets';
import PageHero from '../PageHero.astro';
import { members } from '../../lib/data.js';
import { asset } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pi = members.pi;
const piName = lang === 'ko' ? `${pi.name_ko} (${pi.name_en})` : `${pi.name_en}, ${pi.degree}`;
const piTitle = pick(pi, 'title', lang);
const piAffil = pick(pi, 'affiliation', lang);
const piBio = pick(pi, 'bio', lang);

const initials = (name) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

const memberName = (m) => (lang === 'ko' ? m.name_ko || m.name_en : m.name_en);
const memberSince = (m) => (lang === 'ko' ? m.since_ko || m.since : m.since);

const piPhoto = asset(pi.photo);
---

<PageHero kicker={t('page.kicker.people')} title={t('people.title')} />

<!-- ── Principal Investigator ─────────────────────────────────────────── -->
<section class="section-tight">
  <div class="container">
    <p class="kicker">{t('people.pi')}</p>

    <div class="pi">
      <div class="pi-photo">
        {
          piPhoto ? (
            <Image src={piPhoto} alt={piName} width={300} densities={[1, 2]} />
          ) : (
            <div class="avatar avatar-lg" aria-hidden="true">
              {initials(pi.name_en)}
            </div>
          )
        }
      </div>

      <div class="pi-body">
        <h2>{piName}</h2>
        <p class="role">{piTitle}</p>
        <p class="affil">{piAffil}</p>

        <ul class="pi-contact">
          <li><a href={`mailto:${pi.email}`}>{pi.email}</a></li>
          {pi.phone && <li><a href={`tel:${pi.phone}`}>{pi.phone}</a></li>}
          <li class="muted">{pick(pi, 'office', lang)}</li>
        </ul>

        <p class="bio">{piBio}</p>

        <div class="grid grid-2 detail">
          <div>
            <h3>{t('people.career')}</h3>
            <ul class="entries">
              {
                pi.career.map((e) => (
                  <li>
                    <span class="period mono-num">
                      {lang === 'ko' ? e.period_ko || e.period : e.period}
                    </span>
                    <strong>{pick(e, 'role', lang)}</strong>
                    <span class="where">{pick(e, 'place', lang)}</span>
                    {(e.note_en || e.note_ko) && <span class="note">{pick(e, 'note', lang)}</span>}
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3>{t('people.service')}</h3>
            <ul class="entries">
              {
                pi.service.map((e) => (
                  <li>
                    <span class="period mono-num">
                      {lang === 'ko' ? e.period_ko || e.period : e.period}
                    </span>
                    <strong>{pick(e, 'role', lang)}</strong>
                    <span class="where">{pick(e, 'org', lang)}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {/* 목록이 길어 접어둔다. details 라 자바스크립트 없이 동작한다. */}
        <div class="foldouts">
          <details class="fold">
            <summary>
              <h3>{t('people.talks')}</h3>
              <span class="count mono-num">{pi.talks.length}</span>
              <svg class="chev" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.9"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ol class="talks">
              {
                pi.talks.map((k) => (
                  <li>
                    <span class="talk-date mono-num">{k.date}</span>
                    <span class="talk-body">
                      <strong>{pick(k, 'title', lang)}</strong>
                      {(k.host_en || k.host_ko) && (
                        <span class="where">{pick(k, 'host', lang)}</span>
                      )}
                    </span>
                  </li>
                ))
              }
            </ol>
          </details>

          <details class="fold">
            <summary>
              <h3>{t('people.awards')}</h3>
              <span class="count mono-num">{pi.awards.length}</span>
              <svg class="chev" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.9"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ol class="talks">
              {
                pi.awards.map((a) => (
                  <li>
                    <span class="talk-date mono-num">
                      {lang === 'ko' ? a.year_ko || a.year : a.year}
                    </span>
                    <span class="talk-body">
                      <strong>{pick(a, 'title', lang)}</strong>
                      <span class="where">{pick(a, 'org', lang)}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Members ────────────────────────────────────────────────────────── -->
<section class="section members-band">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{t('people.members')}</p>
      <h2>{t('people.members')}</h2>
    </div>

    <div class="groups">
      {
        members.groups.map((group) => (
          <div class="group">
            <h3 class="group-title">
              {pick(group, 'title', lang)}
              <span class="count mono-num">{group.members.length}</span>
            </h3>
            <ul class="grid grid-4">
              {group.members.map((m) => (
                <li class="card person">
                  {asset(m.photo) ? (
                    <Image
                      class="avatar-img"
                      src={asset(m.photo)}
                      alt={memberName(m)}
                      width={62}
                      densities={[1, 2]}
                      loading="lazy"
                    />
                  ) : (
                    <div class="avatar" aria-hidden="true">
                      {initials(m.name_en)}
                    </div>
                  )}
                  <p class="person-name">{memberName(m)}</p>
                  {lang === 'ko' && m.name_ko !== m.name_en && (
                    <p class="person-sub">{m.name_en}</p>
                  )}
                  <p class="person-since mono-num">
                    {t('people.since')} {memberSince(m)}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ── Alumni ─────────────────────────────────────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>{t('people.alumni')}</h2>
    </div>

    {
      members.alumni?.length ? (
        <ul class="alumni">
          {members.alumni.map((a) => (
            <li>
              <span class="al-name">{memberName(a)}</span>
              <span class="al-role muted">{pick(a, 'role', lang)}</span>
              <span class="al-period mono-num muted">{a.period}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">{t('people.no_alumni')}</p>
      )
    }
  </div>
</section>

<style>
  .pi {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .pi-photo :global(img) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .avatar {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    width: 62px;
  }

  .avatar-lg {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    font-size: clamp(2.5rem, 6vw, 3.6rem);
  }

  .pi-body h2 {
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    margin-bottom: 0.35rem;
  }

  .role {
    font-size: 1.02rem;
    font-weight: 550;
    color: var(--accent);
    margin: 0 0 0.2rem;
  }

  .affil {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .pi-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.15rem;
    margin-bottom: 1.35rem;
    font-size: 0.895rem;
  }

  .bio {
    max-width: 66ch;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .detail {
    margin-top: 1.75rem;
  }

  .detail h3 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .entries {
    display: grid;
    gap: 1.05rem;
  }

  /* 클릭해서 펼치는 긴 목록 (초청 강연 / 수상) */
  .foldouts {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .fold {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    padding: 1rem clamp(1.1rem, 2vw, 1.5rem);
  }

  .fold summary {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    list-style: none;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary:hover {
    color: var(--accent);
  }
  .fold summary h3 {
    margin-bottom: 0;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .fold .chev {
    margin-left: auto;
    transition: transform 0.18s ease;
  }
  .fold[open] .chev {
    transform: rotate(180deg);
  }
  .fold[open] summary {
    margin-bottom: 1.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.3rem;
    padding: 0.05rem 0.42rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .talks {
    display: grid;
    gap: 0.15rem;
  }
  .talks li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    align-items: baseline;
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.885rem;
  }
  .talks li:last-child {
    border-bottom: 0;
  }
  .talk-date {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .talk-body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .talk-body strong {
    font-weight: 600;
    color: var(--ink);
    line-height: 1.5;
  }

  @media (max-width: 520px) {
    .talks li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .members-band {
    background: #f6f8fc;
    border-block: 1px solid var(--line);
  }

  .groups {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1.1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0;
  }

  .person {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.15rem;
    padding-block: 1.5rem;
  }

  :global(.avatar-img) {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .person-name {
    margin: 0.75rem 0 0;
    font-size: 0.985rem;
    font-weight: 620;
    color: var(--ink);
  }

  .person-sub {
    margin: 0.05rem 0 0;
    font-size: 0.79rem;
    color: var(--muted);
  }

  .person-since {
    margin: 0.3rem 0 0;
    font-size: 0.755rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .alumni {
    display: grid;
    gap: 0;
    max-width: 780px;
  }

  .alumni li {
    display: grid;
    grid-template-columns: minmax(7rem, auto) minmax(0, 1fr) auto;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }

  .al-name {
    font-weight: 600;
    color: var(--ink);
  }

  .al-period {
    font-size: 0.82rem;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .pi {
      grid-template-columns: minmax(0, 1fr);
    }
    .pi-photo {
      max-width: 220px;
    }
    .avatar-lg {
      aspect-ratio: 1;
      border-radius: 50%;
    }
  }

  @media (max-width: 560px) {
    .alumni li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .al-role {
      grid-column: 1 / -1;
      font-size: 0.82rem;
    }
  }
</style>
