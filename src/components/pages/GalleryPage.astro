---
import { Image, getImage } from 'astro:assets';
import PageHero from '../PageHero.astro';
import { gallery } from '../../lib/data.js';
import { galleryPhotos } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 행사 하나가 카드 하나. 카드를 누르면 그 행사의 사진을 크게 넘겨본다.
const events = await Promise.all(
  gallery.events
    .map((e) => ({ ...e, photos: galleryPhotos(e.folder) }))
    .filter((e) => e.photos.length > 0)
    .map(async (e) => ({
      ...e,
      // 크게 보기용 1400px webp. 원본(3~4MB)을 그대로 열면 너무 느리다.
      large: await Promise.all(
        e.photos.map((photo) => getImage({ src: photo, width: 1400, format: 'webp' }))
      ),
    }))
);

const countLabel = (n) => (lang === 'ko' ? `사진 ${n}장` : `${n} photo${n > 1 ? 's' : ''}`);
// 영상이 있으면 사진 장수 뒤에 덧붙인다.
const metaLabel = (e) =>
  e.video ? `${countLabel(e.photos.length)} · ${lang === 'ko' ? '영상 1개' : '1 video'}` : countLabel(e.photos.length);
---

<PageHero
  kicker={t('page.kicker.gallery')}
  title={t('news.gallery')}
  lead={t('news.gallery_lead')}
/>

<section class="section">
  <div class="container">
    <ul class="grid grid-3 events">
      {
        events.map((e) => (
          <li>
            <button
              class="card card-hover event"
              type="button"
              data-gallery={JSON.stringify([
                ...e.large.map((l) => ({ type: 'image', src: l.src })),
                ...(e.video ? [{ type: 'video', src: e.video }] : []),
              ])}
              data-title={pick(e, 'title', lang)}
            >
              <span class="cover">
                <Image
                  src={e.photos[0]}
                  alt=""
                  width={480}
                  densities={[1, 2]}
                  loading="lazy"
                />
                <span class="count mono-num">{e.photos.length + (e.video ? 1 : 0)}</span>
                {e.video && (
                  <span class="has-video" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                      <path d="M5 3.5v9l8-4.5-8-4.5Z" />
                    </svg>
                  </span>
                )}
              </span>
              <span class="body">
                <span class="ev-title">{pick(e, 'title', lang)}</span>
                <span class="ev-meta mono-num">
                  {e.date && <>{e.date.replace('-', '.')} · </>}
                  {metaLabel(e)}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- 사진 크게 보기 (한 행사 안에서 앞뒤로 넘길 수 있다) -->
<dialog class="lightbox" aria-label={t('news.gallery')}>
  <button class="lb-close" type="button" aria-label={t('nav.close')}>
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <button class="lb-nav lb-prev" type="button" aria-label={t('news.prev_photo')}>
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    {/* 기본은 음소거. 컨트롤에 음소거 해제 버튼이 있어 원하면 소리를 켤 수 있다. */}
    <video class="lb-video" controls muted playsinline preload="metadata" hidden></video>
    <figcaption class="lb-cap"></figcaption>
  </figure>

  <button class="lb-nav lb-next" type="button" aria-label={t('news.next_photo')}>
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</dialog>

<style>
  .events {
    align-items: stretch;
  }
  .events li {
    display: flex;
  }

  .event {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  /* 영상이 있는 행사에는 재생 표시를 얹는다. */
  .has-video {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    padding-left: 1px;
    border-radius: 50%;
    background: rgba(10, 16, 28, 0.72);
    color: #fff;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .event:hover .cover :global(img) {
    transform: scale(1.04);
  }

  .count {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(10, 16, 28, 0.72);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .body {
    display: block;
    padding: 1rem clamp(1rem, 2vw, 1.25rem) 1.15rem;
  }
  .ev-title {
    display: block;
    font-size: 0.98rem;
    font-weight: 620;
    line-height: 1.45;
    color: var(--ink);
    letter-spacing: -0.008em;
  }
  .ev-meta {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* ── 크게 보기 ─────────────────────────────────────────────────── */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 28, 0.94);
    color: #fff;
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: flex;
  }
  .lightbox::backdrop {
    background: rgba(10, 16, 28, 0.94);
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    max-width: min(1400px, 92vw);
  }
  .lb-img,
  .lb-video {
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #0a101c;
  }
  .lb-cap {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
    text-align: center;
  }

  .lb-nav,
  .lb-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .lb-nav:hover,
  .lb-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lb-nav[hidden] {
    visibility: hidden;
    display: grid;
  }
  .lb-close {
    position: absolute;
    top: max(0.9rem, env(safe-area-inset-top));
    right: 0.9rem;
  }
  .lightbox :focus-visible {
    outline: 2px solid #7ea6ff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .lb-nav {
      position: absolute;
      bottom: 1.25rem;
      z-index: 1;
    }
    .lb-prev {
      left: 1.25rem;
    }
    .lb-next {
      right: 1.25rem;
    }
    .lb-img,
    .lb-video {
      max-height: 68dvh;
    }
  }
</style>

<script>
  const dialog = document.querySelector('.lightbox');
  const img = dialog?.querySelector('.lb-img');
  const video = dialog?.querySelector('.lb-video');
  const cap = dialog?.querySelector('.lb-cap');
  const prev = dialog?.querySelector('.lb-prev');
  const next = dialog?.querySelector('.lb-next');

  // 카드 하나가 한 행사. 그 행사의 사진 목록 안에서만 앞뒤로 넘긴다.
  let photos = [];
  let title = '';
  let index = 0;
  let opener = null;

  const show = (i) => {
    index = (i + photos.length) % photos.length;
    const item = photos[index];
    const isVideo = item.type === 'video';

    // 슬라이드를 벗어나면 재생 중이던 영상을 멈춘다.
    video.pause();

    // 한 번에 하나만 보여준다. 보이지 않는 쪽은 src 도 비워
    // 플레이어가 남아 있거나 계속 내려받지 않게 한다.
    img.hidden = isVideo;
    video.hidden = !isVideo;
    if (isVideo) {
      video.src = item.src;
      img.removeAttribute('src');
    } else {
      img.src = item.src;
      video.removeAttribute('src');
    }

    cap.textContent = `${title} (${index + 1}/${photos.length})`;
    const single = photos.length < 2;
    prev.hidden = single;
    next.hidden = single;
  };

  document.querySelectorAll('[data-gallery]').forEach((card) => {
    card.addEventListener('click', () => {
      photos = JSON.parse(card.dataset.gallery);
      title = card.dataset.title ?? '';
      opener = card;
      show(0);
      dialog.showModal();
    });
  });

  prev?.addEventListener('click', () => show(index - 1));
  next?.addEventListener('click', () => show(index + 1));
  dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());

  // 사진 바깥(배경)을 누르면 닫는다.
  dialog?.addEventListener('click', (e) => {
    if (!e.target.closest('.lb-figure, .lb-nav, .lb-close')) dialog.close();
  });

  // 닫히면 눌렀던 카드로 초점을 돌려준다.
  dialog?.addEventListener('close', () => {
    video?.pause();
    opener?.focus();
  });

  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // 모바일 좌우 스와이프
  let startX = null;
  dialog?.addEventListener(
    'touchstart',
    (e) => {
      startX = e.changedTouches[0].clientX;
    },
    { passive: true }
  );
  dialog?.addEventListener(
    'touchend',
    (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 45) show(index + (dx < 0 ? 1 : -1));
      startX = null;
    },
    { passive: true }
  );
</script>
