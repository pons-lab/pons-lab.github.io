---
import { Image, getImage } from 'astro:assets';
import PageHero from '../PageHero.astro';
import { gallery } from '../../lib/data.js';
import { galleryPhotos } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// yaml 의 순서대로, 각 행사 폴더에 든 사진을 모두 가져온다.
const events = await Promise.all(
  gallery.events
    .map((e) => ({ ...e, photos: galleryPhotos(e.folder) }))
    .filter((e) => e.photos.length > 0)
    .map(async (e) => ({
      ...e,
      // 크게 보기용 1400px webp. 원본(3~4MB)을 그대로 열면 너무 느리다.
      large: await Promise.all(
        e.photos.map((photo) => getImage({ src: photo, width: 1400, format: 'webp' }))
      ),
    }))
);
---

<PageHero
  kicker={t('page.kicker.gallery')}
  title={t('news.gallery')}
  lead={t('news.gallery_lead')}
/>

<section class="section">
  <div class="container">
    <div class="events">
      {
        events.map((e) => (
          <section class="event">
            <h2 class="event-title">
              <span>{pick(e, 'title', lang)}</span>
              {e.date && <span class="event-date mono-num">{e.date.replace('-', '.')}</span>}
            </h2>
            <ul class="shots">
              {e.photos.map((photo, i) => (
                <li class="shot">
                  <a
                    href={e.large[i].src}
                    data-lightbox
                    data-caption={`${pick(e, 'title', lang)} (${i + 1}/${e.photos.length})`}
                    aria-label={`${pick(e, 'title', lang)} (${i + 1}/${e.photos.length}) — ${t('news.view_full')}`}
                  >
                    <Image src={photo} alt="" width={320} densities={[1, 2]} loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<!-- 사진 크게 보기 (같은 행사 안에서 앞뒤로 넘길 수 있다) -->
<dialog class="lightbox" aria-label={t('news.gallery')}>
  <button class="lb-close" type="button" aria-label={t('nav.close')}>
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <button class="lb-nav lb-prev" type="button" aria-label={t('news.prev_photo')}>
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    <figcaption class="lb-cap"></figcaption>
  </figure>

  <button class="lb-nav lb-next" type="button" aria-label={t('news.next_photo')}>
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</dialog>

<style>
  .events {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
  }

  .event-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 650;
    color: var(--ink);
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .event-date {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    flex: none;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.75rem;
  }

  .shot {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
    aspect-ratio: 4 / 3;
  }

  .shot a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .shot:hover :global(img) {
    transform: scale(1.04);
  }

  /* ── 크게 보기 ─────────────────────────────────────────────────── */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 28, 0.94);
    color: #fff;
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: flex;
  }
  .lightbox::backdrop {
    background: rgba(10, 16, 28, 0.94);
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    max-width: min(1400px, 92vw);
  }
  .lb-img {
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #0a101c;
  }
  .lb-cap {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
    text-align: center;
  }

  .lb-nav,
  .lb-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .lb-nav:hover,
  .lb-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lb-nav[hidden] {
    visibility: hidden;
    display: grid;
  }
  .lb-close {
    position: absolute;
    top: max(0.9rem, env(safe-area-inset-top));
    right: 0.9rem;
  }
  .lightbox :focus-visible {
    outline: 2px solid #7ea6ff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .lb-nav {
      position: absolute;
      bottom: 1.25rem;
      z-index: 1;
    }
    .lb-prev {
      left: 1.25rem;
    }
    .lb-next {
      right: 1.25rem;
    }
    .lb-img {
      max-height: 68dvh;
    }
  }

  @media (max-width: 560px) {
    .shots {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.5rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector('.lightbox');
  const img = dialog?.querySelector('.lb-img');
  const cap = dialog?.querySelector('.lb-cap');
  const prev = dialog?.querySelector('.lb-prev');
  const next = dialog?.querySelector('.lb-next');

  // 클릭한 사진이 속한 행사(ul.shots) 안에서만 앞뒤로 넘긴다.
  let group = [];
  let index = 0;

  const show = (i) => {
    index = (i + group.length) % group.length;
    const link = group[index];
    img.src = link.href;
    cap.textContent = link.dataset.caption ?? '';
    const single = group.length < 2;
    prev.hidden = single;
    next.hidden = single;
  };

  document.querySelectorAll('a[data-lightbox]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      group = [...link.closest('ul').querySelectorAll('a[data-lightbox]')];
      show(group.indexOf(link));
      dialog.showModal();
    });
  });

  prev?.addEventListener('click', () => show(index - 1));
  next?.addEventListener('click', () => show(index + 1));
  dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());

  // 사진 바깥(배경)을 누르면 닫는다.
  dialog?.addEventListener('click', (e) => {
    if (!e.target.closest('.lb-figure, .lb-nav, .lb-close')) dialog.close();
  });

  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // 모바일 좌우 스와이프
  let startX = null;
  dialog?.addEventListener(
    'touchstart',
    (e) => {
      startX = e.changedTouches[0].clientX;
    },
    { passive: true }
  );
  dialog?.addEventListener(
    'touchend',
    (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 45) show(index + (dx < 0 ? 1 : -1));
      startX = null;
    },
    { passive: true }
  );
</script>
