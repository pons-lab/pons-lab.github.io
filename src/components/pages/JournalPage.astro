---
import PageHero from '../PageHero.astro';
import PublicationItem from '../PublicationItem.astro';
import { publications, cv, journalsByYear } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { unpublished, groups } = journalsByYear();
const journalCount = publications.journals.length;
const conferenceCount = publications.conferences.length;
const patentCount = cv.patents.length;
---

<PageHero kicker={t('page.kicker.publications')} title={t('pub.journals')}>
  <p class="counts">
    <span class="count-chip">
      <strong class="mono-num">{journalCount}</strong> {t('pub.count_journals')}
    </span>
    <a class="count-chip link" href={localizePath('/publications/conference', lang)}>
      <strong class="mono-num">{conferenceCount}</strong> {t('pub.count_conferences')} →
    </a>
    <a class="count-chip link" href={localizePath('/publications/patent', lang)}>
      <strong class="mono-num">{patentCount}</strong> {t('pub.count_patents')} →
    </a>
  </p>
  <p class="legend small muted">{t('pub.legend')}</p>

  <nav class="jump" aria-label={t('pub.jump')}>
    {unpublished.length > 0 && <a href="#y-review">{t('pub.unpublished')}</a>}
    {
      groups.map((g) => (
        <a class="mono-num" href={`#y-${g.year}`}>
          {g.year}
        </a>
      ))
    }
  </nav>
</PageHero>

<section class="section">
  <div class="container">
    {
      unpublished.length > 0 && (
        <div class="year-block">
          <h2 class="year" id="y-review">{t('pub.unpublished')}</h2>
          <div class="items">
            {unpublished.map((pub) => (
              <PublicationItem pub={pub} level={3} />
            ))}
          </div>
        </div>
      )
    }

    {
      groups.map((group) => (
        <div class="year-block">
          <h2 class="year mono-num" id={`y-${group.year}`}>
            {group.year}
          </h2>
          <div class="items">
            {group.items.map((pub) => (
              <PublicationItem pub={pub} level={3} />
            ))}
          </div>
        </div>
      ))
    }

    <p class="to-other">
      <a class="link-arrow" href={localizePath('/publications/conference', lang)}>
        {t('pub.conferences')}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    margin: 0.9rem 0 0.75rem;
  }

  .count-chip {
    font-size: 0.9rem;
    color: var(--body);
  }
  .count-chip strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.25rem;
  }
  a.count-chip {
    text-decoration: none;
    color: var(--muted);
  }
  a.count-chip strong {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  a.count-chip:hover,
  a.count-chip:hover strong {
    color: var(--accent);
    text-decoration: none;
  }

  .legend {
    margin: 0;
    max-width: 60ch;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .jump a {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--body);
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .year-block + .year-block {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* 긴 목록을 스크롤하는 동안 지금 보는 연도가 계속 보이도록 고정한다.
     배경이 투명하면 아래 논문 글자가 비쳐 겹치므로 페이지 배경색을 채운다. */
  .year {
    position: sticky;
    top: 69px;
    z-index: 3;
    background: var(--page);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 0.35rem;
    padding-block: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .items {
    display: grid;
  }

  .to-other {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }
</style>
