---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section join-section">
  <div class="container">
    <div class="join">
      <div>
        <h2>{t('home.join_title')}</h2>
        <p>{site.recruiting[lang]}</p>
      </div>
      <a class="btn btn-on-dark" href={localizePath('/contact', lang)}>
        {t('cta.how_to_apply')} →
      </a>
    </div>
  </div>
</section>

<style>
  .join-section {
    padding-bottom: 0;
  }

  .join {
    background: #101a2e;
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    color: #fff;
  }

  .join h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.5rem);
    color: #fff;
    margin: 0;
  }

  .join p {
    color: #9db0d0;
    font-size: 0.905rem;
    margin: 0.375rem 0 0;
    max-width: 520px;
    line-height: 1.65;
  }

  .btn-on-dark {
    background: #fff;
    color: #101a2e;
    flex: none;
  }
  .btn-on-dark:hover {
    background: #e8eefc;
    color: #101a2e;
  }
</style>
