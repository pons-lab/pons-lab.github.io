---
import { site } from '../../lib/data.js';
import { asset } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const how = lang === 'ko' ? site.recruiting.how_to_apply_ko : site.recruiting.how_to_apply_en;

// 배경 그림. site.yaml 의 join_background 가 비어 있으면 단색 밴드다.
// (논문 그림을 받으면 여기에 넣을 자리)
const bg = asset(site.join_background)?.src ?? null;
---

<section class="band-dark join" data-bg={bg ? '' : undefined}>
  {bg && <div class="bg" style={`background-image:url(${bg})`} aria-hidden="true" />}
  <div class="container inner">
    <h2>{t('home.join_title')}</h2>
    <p class="who">{site.recruiting[lang]} {how}</p>
    <div class="btn-row">
      <a class="btn btn-light" href={`mailto:${site.contact.email}`}>{t('cta.email')}</a>
      <a class="btn btn-outline-light" href={localizePath('/contact', lang)}>
        {t('cta.contact')}
      </a>
    </div>
  </div>
</section>

<style>
  .join {
    padding-block: clamp(4rem, 8vw, 6rem);
    background: var(--ink);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.25;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  /* 밴드 하나에서만 쓰는 큰 제목이라 크기는 여기에 둔다. */
  h2 {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    max-width: 16em;
    margin-bottom: 1.25rem;
  }

  .who {
    font-size: var(--text-lead);
    color: rgba(255, 255, 255, 0.78);
    max-width: 44em;
    margin-bottom: 1.9rem;
  }
</style>
