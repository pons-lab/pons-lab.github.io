---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const how = lang === 'ko' ? site.recruiting.how_to_apply_ko : site.recruiting.how_to_apply_en;
---

<section class="section">
  <div class="container join">
    {
      /* 한국어 페이지에서는 별도 제목 없이 모집 문구만 보여준다. */
      lang === 'ko' ? (
        <h2 class="ko-heading">{site.recruiting.ko}</h2>
      ) : (
        <>
          <h2>{t('home.join_title')}</h2>
          <p class="who">{site.recruiting.en}</p>
          <p class="how">{how}</p>
        </>
      )
    }
    <div class="btn-row">
      <a class="t-btn t-btn--primary t-btn--lg" href={`mailto:${site.contact.email}`}>
        {t('cta.email')}
      </a>
      <a class="t-btn t-btn--grey t-btn--lg" href={localizePath('/contact', lang)}>
        {t('cta.contact')}
      </a>
    </div>
  </div>
</section>

<style>
  .join {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h2 {
    margin-bottom: 0.75rem;
  }

  .ko-heading {
    font-size: var(--text-block-title);
    max-width: 30ch;
    margin-bottom: 1.5rem;
  }

  .who {
    max-width: 52ch;
    margin-bottom: 0.5rem;
    color: var(--text-3);
  }

  .how {
    max-width: 52ch;
    margin-bottom: 2rem;
    font-size: var(--text-md);
    color: var(--text-4);
  }

  .btn-row {
    justify-content: center;
  }
</style>
