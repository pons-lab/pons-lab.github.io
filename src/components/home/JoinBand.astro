---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const how = lang === 'ko' ? site.recruiting.how_to_apply_ko : site.recruiting.how_to_apply_en;
---

<section class="band-dark join">
  <div class="container inner">
    <div class="copy">
      {
        /* 한국어 페이지에서는 별도 제목 없이 모집 문구만 보여준다. */
        lang === 'ko' ? (
          <h2 class="ko-heading">{site.recruiting.ko}</h2>
        ) : (
          <>
            <h2>{t('home.join_title')}</h2>
            <p class="who">{site.recruiting.en}</p>
            <p class="how">{how}</p>
          </>
        )
      }
      <div class="btn-row">
        <a class="btn btn-light" href={`mailto:${site.contact.email}`}>{t('cta.email')}</a>
        <a class="btn btn-outline-light" href={localizePath('/contact', lang)}>
          {t('cta.contact')}
        </a>
      </div>
    </div>
  </div>

  <svg class="deco" viewBox="0 0 600 300" aria-hidden="true" role="presentation">
    <path
      d="M0 150 C 90 60, 210 60, 300 150 C 390 240, 510 240, 600 150"
      fill="none"
      stroke="#7ea6ff"
      stroke-width="1.4"
      opacity="0.4"></path>
    <path
      d="M0 190 C 90 100, 210 100, 300 190 C 390 280, 510 280, 600 190"
      fill="none"
      stroke="#7ea6ff"
      stroke-width="1.4"
      opacity="0.22"></path>
    <path
      d="M0 110 C 90 20, 210 20, 300 110 C 390 200, 510 200, 600 110"
      fill="none"
      stroke="#7ea6ff"
      stroke-width="1.4"
      opacity="0.14"></path>
  </svg>
</section>

<style>
  .join {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(700px 400px at 88% 110%, #1d3566 0%, rgba(29, 53, 102, 0) 62%),
      var(--ink);
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .copy {
    max-width: 44rem;
  }

  h2 {
    margin-bottom: 0.85rem;
    max-width: 18ch;
  }

  /* 한국어: 모집 문구 자체가 제목 역할을 하므로 문장에 어울리는 크기로 */
  .ko-heading {
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    line-height: 1.5;
    max-width: 30ch;
    margin-bottom: 1.6rem;
  }

  .who {
    font-size: clamp(1.02rem, 1.5vw, 1.12rem);
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 0.55rem;
    max-width: 52ch;
  }

  .how {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.94rem;
    margin-bottom: 1.8rem;
    max-width: 52ch;
  }

  .deco {
    position: absolute;
    right: -4%;
    bottom: -12%;
    width: min(52%, 620px);
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .deco {
      opacity: 0.5;
      width: 90%;
      right: -20%;
    }
  }
</style>
