---
import PublicationItem from '../PublicationItem.astro';
import { selectedPublications } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = selectedPublications();
---

<!-- 메인 페이지에서 소식 목록과 나란히 놓이는 한 칸 (HomePage.astro) -->
<div class="col">
  <h2>{t('home.pubs_title')}</h2>
  <ol class="list">
    {
      items.map((pub) => (
        <li>
          <PublicationItem pub={pub} compact />
        </li>
      ))
    }
  </ol>
  <p class="more">
    <a class="link-arrow" href={localizePath('/publications/journal', lang)}>
      {t('cta.all_publications')}
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
    </a>
  </p>
</div>

<style>
  h2 {
    font-size: var(--text-block-title);
    margin-bottom: 1.25rem;
  }

  .list {
    display: grid;
    border-top: 2px solid var(--ink);
  }
  .list li {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* 메인에서는 제목·저널·연도만. 저자와 DOI 는 논문 페이지에서 본다
     (제목 링크가 DOI 로 간다). 소식 칸과 길이를 맞추기 위해서다. */
  .list :global(.authors-line),
  .list :global(.foot) {
    display: none;
  }

  .more {
    margin: 1.25rem 0 0;
  }
</style>
