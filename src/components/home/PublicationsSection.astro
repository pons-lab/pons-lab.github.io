---
import PublicationItem from '../PublicationItem.astro';
import { selectedPublications } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = selectedPublications();
---

<section class="section">
  <div class="container">
    <div class="section-head head-row">
      <h2>{t('home.pubs_title')}</h2>
      <a class="link-arrow" href={localizePath('/publications/journal', lang)}>
        {t('cta.all_publications')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9 18 6-6-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ol class="list">
      {
        items.map((pub) => (
          <li>
            <PublicationItem pub={pub} compact />
          </li>
        ))
      }
    </ol>

    <p class="legend small muted">{t('pub.legend')}</p>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 2.5rem;
  }

  .legend {
    margin: 2.25rem 0 0;
  }
</style>
