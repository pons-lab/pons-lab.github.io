---
import { Image } from 'astro:assets';
import { site } from '../../lib/data.js';
import { asset } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 연구실 정식 명칭. 한국어에서는 국문명 + 영문 약칭 병기.
const labName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
const photo = asset(site.home_hero?.image);
---

<section class="hero">
  <div class="container inner">
    <div class="copy">
      <p class="lab">{labName}</p>
      <h1>{site.tagline[lang]}</h1>
      <p class="intro">{site.intro[lang]}</p>
      <div class="btn-row">
        <a class="t-btn t-btn--primary t-btn--lg" href={localizePath('/research', lang)}>
          {t('cta.research')}
        </a>
        <a class="t-btn t-btn--grey t-btn--lg" href={localizePath('/contact', lang)}>
          {t('cta.join')}
        </a>
      </div>
    </div>

    {
      photo && (
        <figure class="photo">
          <Image
            src={photo}
            alt={pick(site.home_hero, 'alt', lang)}
            widths={[560, 840, 1120]}
            sizes="(max-width: 900px) 100vw, 520px"
            format="webp"
            loading="eager"
          />
        </figure>
      )
    }
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 4.75rem);
  }

  .lab {
    margin: 0 0 0.75rem;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-4);
  }

  h1 {
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .intro {
    margin-bottom: 2rem;
    font-size: var(--text-base);
    color: var(--text-3);
    max-width: 54ch;
  }

  .photo {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
