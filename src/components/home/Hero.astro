---
import { site } from '../../lib/data.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 히어로 kicker 는 연구실 정식 명칭. 한국어에서는 국문명 + 영문 약칭 병기.
const kicker = lang === 'ko' ? site.name.display_ko : site.name.full_en;
const headline = inlineMd(site.tagline_rich[lang]);
---

<header class="hero">
  <div class="container">
    <p class="kicker kicker-plain">{kicker}</p>
    <h1 set:html={headline} />
    <p class="sub">{site.intro[lang]}</p>
    <div class="cta">
      <a class="btn btn-primary" href={localizePath('/research', lang)}>{t('cta.research')}</a>
      <a class="btn btn-ghost" href={localizePath('/contact', lang)}>{t('cta.join')} →</a>
    </div>

    <svg class="wave" viewBox="0 0 520 200" fill="none" aria-hidden="true" role="presentation">
      <path
        d="M0 100 q20 0 30 -8 t25 -30 t18 60 t22 -80 t20 95 t18 -60 t25 25 t30 -6 t40 4 t30 -18 t22 -45 t18 70 t20 -55 t25 40 t35 8 t45 0 t44 -2"
        stroke="#2153c4"
        stroke-width="2.5"
        opacity=".55"></path>
      <path
        d="M0 150 q30 0 45 -6 t30 -18 t25 30 t28 -40 t24 45 t26 -28 t35 14 t45 3 t60 -4 t60 4 t62 0"
        stroke="#93b3ec"
        stroke-width="2"
        opacity=".6"></path>
    </svg>
  </div>
</header>

<style>
  .hero {
    padding: clamp(3rem, 6vw, 5.25rem) 0 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero .container {
    position: relative;
  }

  .kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.125rem;
  }

  h1 {
    font-size: clamp(2.125rem, 5vw, 3.375rem);
    line-height: 1.12;
    max-width: 720px;
    margin-bottom: 0;
  }

  h1 :global(em) {
    font-style: normal;
    color: var(--accent);
  }

  .sub {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--body);
    max-width: 620px;
    line-height: 1.7;
  }

  .cta {
    margin-top: 1.875rem;
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .wave {
    position: absolute;
    right: -40px;
    top: 104px;
    width: 520px;
    max-width: none;
    opacity: 0.9;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .wave {
      display: none;
    }
  }
</style>
