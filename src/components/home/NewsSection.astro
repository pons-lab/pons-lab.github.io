---
import { getCollection } from 'astro:content';
import NewsItem from '../NewsItem.astro';
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 몇 건을 보여줄지는 site.yaml 에서 정한다.
const items = (await getCollection('news'))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, site.home_news_count ?? 3);
---

<!-- 메인 페이지에서 논문 목록과 나란히 놓이는 한 칸 (HomePage.astro) -->
<div class="col">
  <h2>{t('home.news_title')}</h2>
  <ul class="news-list">
    {items.map((item) => <NewsItem item={item} compact />)}
  </ul>
  <p class="more">
    <a class="link-arrow" href={localizePath('/news', lang)}>
      {t('cta.all_news')}
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
    </a>
  </p>
</div>

<style>
  h2 {
    font-size: var(--text-block-title);
    margin-bottom: 1.25rem;
  }

  .news-list {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  /* 좁은 칸이라 날짜·태그를 제목 위에 둔다. */
  .news-list :global(.news-item) {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding: 1.1rem 0;
  }

  .more {
    margin: 1.25rem 0 0;
  }
</style>
