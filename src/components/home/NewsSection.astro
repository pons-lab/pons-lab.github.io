---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath, formatDate } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = (await getCollection('news')).sort((a, b) => b.data.date - a.data.date).slice(0, 3);

const titleOf = (d) => (lang === 'ko' ? d.title_ko || d.title : d.title);
const dateOf = (d) => {
  const y = d.date.getUTCFullYear();
  const m = String(d.date.getUTCMonth() + 1).padStart(2, '0');
  return `${y}.${m}`;
};
---

<section class="section">
  <div class="container">
    <h2 class="sec-title">{t('home.news_title')}</h2>
    <p class="sec-sub">{t('home.news_lead')}</p>

    <div class="news-grid">
      {
        items.map((item) => (
          <a class="news-card" href={localizePath('/news', lang)}>
            <div class="date mono-num">{dateOf(item.data)}</div>
            <h3>{titleOf(item.data)}</h3>
          </a>
        ))
      }
    </div>

    <a class="more" href={localizePath('/news', lang)}>{t('cta.all_news')} →</a>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .news-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.375rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .news-card:hover {
    border-color: #bcd0f5;
    box-shadow: 0 8px 24px rgba(33, 83, 196, 0.08);
    text-decoration: none;
  }

  .date {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .news-card h3 {
    font-size: 0.97rem;
    font-family: var(--font-sans);
    font-weight: 600;
    margin: 0.5rem 0 0;
    line-height: 1.5;
    color: var(--ink);
  }

  .more {
    margin-top: 1.625rem;
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
