---
import { getCollection } from 'astro:content';
import NewsItem from '../NewsItem.astro';
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 몇 건을 보여줄지는 site.yaml 에서 정한다.
const items = (await getCollection('news'))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, site.home_news_count ?? 3);
---

<section class="section">
  <div class="container">
    <div class="section-head head-row">
      <h2>{t('home.news_title')}</h2>
      <a class="link-arrow" href={localizePath('/news', lang)}>
        {t('cta.all_news')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9 18 6-6-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ul class="news-list">
      {items.map((item) => <NewsItem item={item} compact />)}
    </ul>
  </div>
</section>

<style>
  .news-list {
    display: grid;
  }
</style>
