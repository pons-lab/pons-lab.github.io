---
import { Image } from 'astro:assets';
import { gallery } from '../../lib/data.js';
import { galleryPhotos } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// gallery.yaml 맨 위의 행사(최신) 3건을 자동으로 보여준다.
const events = gallery.events
  .map((e) => ({ ...e, cover: galleryPhotos(e.folder)[0] }))
  .filter((e) => e.cover)
  .slice(0, 3);
---

<section class="section">
  <div class="container">
    <div class="section-head head-row">
      <h2>{t('home.life_title')}</h2>
      <a class="link-arrow" href={localizePath('/gallery', lang)}>
        {t('cta.all_photos')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9 18 6-6-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ul class="grid grid-3">
      {
        events.map((e) => (
          <li>
            <a class="event" href={localizePath('/gallery', lang)}>
              <span class="cover">
                <Image src={e.cover} alt="" width={560} format="webp" loading="lazy" />
              </span>
              <span class="title">{pick(e, 'title', lang)}</span>
              {e.date && <span class="date mono-num">{e.date.replace('-', '.')}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .event {
    display: block;
    color: inherit;
  }
  .event:hover {
    text-decoration: none;
  }

  .cover {
    display: block;
    aspect-ratio: 4 / 3;
    margin-bottom: 0.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .event:hover .cover :global(img) {
    transform: scale(1.2);
  }

  .title {
    display: block;
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.45;
    color: var(--text-1);
    transition: color 0.2s;
  }
  .event:hover .title {
    color: var(--accent-fg);
  }

  .date {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--text-4);
  }

  @media (max-width: 900px) {
    li:nth-child(3) {
      display: none;
    }
  }
  @media (max-width: 640px) {
    li:nth-child(3) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event:hover .cover :global(img) {
      transform: none;
    }
  }
</style>
