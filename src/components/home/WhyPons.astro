---
import { site } from '../../lib/data.js';
import { asset } from '../../lib/images.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const story = inlineMd(site.brand.story[lang]);
const figure = site.brand.figure;
---

<section class="section">
  <div class="container">
    <div class="top">
      <div class="story">
        <h2>{t('home.why_title')}</h2>
        <p class="body" set:html={story} />
      </div>
      <figure class="pons-figure">
        <img src={asset(figure.image)?.src} alt={pick(figure, 'alt', lang)} loading="lazy" />
        <figcaption lang="en">{figure.credit}</figcaption>
      </figure>
    </div>

    <ul class="grid grid-4">
      {
        site.brand.cards.map((card) => (
          <li class="card pons-card">
            <span class="letter" aria-hidden="true">
              {card.letter}
            </span>
            <h3>{card.word}</h3>
            <p>{pick(card, 'text', lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: 2.25rem;
  }
  .pons-figure {
    margin: 0;
  }
  .pons-figure img {
    width: 100%;
    height: auto;
  }
  .pons-figure figcaption {
    margin-top: 0.5rem;
    font-size: var(--text-3xs);
    line-height: 1.45;
    color: var(--text-4);
  }
  @media (max-width: 760px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .pons-figure {
      max-width: 260px;
    }
  }
  .story h2 {
    margin-bottom: 0.75rem;
  }
  .body {
    max-width: 68ch;
    margin: 0;
    color: var(--text-3);
  }
  .body :global(strong) {
    font-weight: 700;
    color: var(--text-1);
  }

  .pons-card {
    display: flex;
    flex-direction: column;
  }

  .letter {
    margin-bottom: 0.75rem;
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-1);
  }

  .pons-card h3 {
    margin-bottom: 0.5rem;
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-2);
  }

  .pons-card p {
    margin: 0;
    font-size: var(--text-md);
    color: var(--text-4);
  }
</style>
