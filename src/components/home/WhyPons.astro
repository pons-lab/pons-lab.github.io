---
import { site } from '../../lib/data.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const story = inlineMd(site.brand.story[lang]);
---

<section class="section why">
  <div class="container">
    <div class="top">
      <div class="story">
        <p class="kicker">{t('home.why_kicker')}</p>
        <h2>{t('home.why_title')}</h2>
        <p class="lead" set:html={story} />
      </div>

      <!-- 뇌(brain) ↔ 몸(body) 을 잇는 다리 — 이름의 은유를 그림으로 -->
      <figure class="bridge" aria-hidden="true">
        <svg viewBox="0 0 460 190" role="presentation">
          <defs>
            <linearGradient id="strand-a" x1="0" x2="1">
              <stop offset="0" stop-color="#2153c4"></stop>
              <stop offset="1" stop-color="#5b8bf0"></stop>
            </linearGradient>
            <linearGradient id="strand-b" x1="1" x2="0">
              <stop offset="0" stop-color="#2153c4"></stop>
              <stop offset="1" stop-color="#8fb0ee"></stop>
            </linearGradient>
            <path
              id="twist-a"
              d="M96 95 C 132 40, 168 40, 204 95 S 276 150, 312 95 S 348 47, 364 95"></path>
            <path
              id="twist-b"
              d="M96 95 C 132 150, 168 150, 204 95 S 276 40, 312 95 S 348 143, 364 95"></path>
          </defs>

          <!-- 뇌와 몸을 잇는 두 가닥이 서로를 감으며 지나간다 (pons = 잇는 다리) -->
          <use href="#twist-b" class="strand" stroke="url(#strand-b)"></use>
          <use href="#twist-a" class="strand" stroke="url(#strand-a)"></use>

          <!-- 두 가닥이 만나는 지점 -->
          <g fill="#fff" stroke="#2153c4" stroke-width="1.6">
            <circle cx="204" cy="95" r="4"></circle>
            <circle cx="312" cy="95" r="4"></circle>
          </g>

          <!-- 왼쪽: 뇌 -->
          <g transform="translate(58 95)">
            <circle cx="0" cy="0" r="30" fill="#e8eefc"></circle>
            <path
              d="M-12 7c-6-2-7-10-2-14-2-6 4-11 9-9 3-5 11-3 12 2 6 1 7 9 2 12 1 6-4 10-10 8-3 3-9 2-11 1Z"
              fill="none" stroke="#2153c4" stroke-width="1.8" stroke-linejoin="round"></path>
            <path d="M0-16v25M0-5h7M0 3h-7" stroke="#2153c4" stroke-width="1.4"
              stroke-linecap="round" opacity="0.7"></path>
          </g>

          <!-- 오른쪽: 몸(심장) -->
          <g transform="translate(402 95)">
            <circle cx="0" cy="0" r="30" fill="#e8eefc"></circle>
            <path
              d="M0 12c-9-7-15-11-15-18a7.5 7.5 0 0 1 15-2 7.5 7.5 0 0 1 15 2c0 7-6 11-15 18Z"
              fill="none" stroke="#2153c4" stroke-width="1.8" stroke-linejoin="round"></path>
          </g>

          <!-- 신호가 두 가닥을 서로 반대 방향으로 오간다 -->
          <circle class="pulse pulse-a" r="4.5" fill="#16233b">
            <animateMotion dur="5s" repeatCount="indefinite" keyPoints="0;1"
              keyTimes="0;1" calcMode="linear">
              <mpath href="#twist-a"></mpath>
            </animateMotion>
          </circle>
          <circle class="pulse pulse-b" r="4" fill="#2153c4">
            <animateMotion dur="5s" begin="2.5s" repeatCount="indefinite" keyPoints="1;0"
              keyTimes="0;1" calcMode="linear">
              <mpath href="#twist-b"></mpath>
            </animateMotion>
          </circle>
        </svg>
        <figcaption class="bridge-cap">
          <span>brain</span>
          <span class="bridge-word">pons · bridge</span>
          <span>body</span>
        </figcaption>
      </figure>
    </div>

    <ul class="grid grid-4 cards">
      {
        site.brand.cards.map((card) => (
          <li class="card pons-card">
            <span class="letter" aria-hidden="true">
              {card.letter}
            </span>
            <h3>{card.word}</h3>
            <p>{pick(card, 'text', lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background:
      radial-gradient(900px 420px at 92% 4%, #eff3fc 0%, rgba(239, 243, 252, 0) 66%),
      #f6f8fc;
    border-block: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  .story h2 {
    margin-bottom: 0.9rem;
  }

  .story .lead {
    max-width: 56ch;
    margin-bottom: 0;
  }

  .story .lead :global(strong) {
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .story .lead :global(em) {
    font-style: italic;
    color: var(--body);
  }

  .bridge {
    margin: 0;
  }
  .bridge svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .strand {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    animation: weave 1.8s ease-out forwards;
  }
  .strand + .strand {
    animation-delay: 0.25s;
  }
  @keyframes weave {
    to {
      stroke-dashoffset: 0;
    }
  }

  .pulse {
    opacity: 0.85;
  }

  .bridge-cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.35rem;
    padding-inline: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bridge-word {
    color: var(--accent);
    font-family: var(--font-display);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.83rem;
    font-style: italic;
  }

  .cards {
    align-items: stretch;
  }

  .pons-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .letter {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
    margin-bottom: 0.55rem;
  }

  .pons-card h3 {
    font-family: var(--font-sans);
    font-size: 0.775rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .pons-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.62;
    color: var(--body);
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .bridge {
      max-width: 460px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strand {
      stroke-dashoffset: 0;
      animation: none;
    }
    .pulse {
      display: none;
    }
  }
</style>
