---
import { site } from '../../lib/data.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const story = inlineMd(site.brand.story[lang]);
const brainLabel = lang === 'ko' ? '뇌' : 'Brain';
const bodyLabel = lang === 'ko' ? '몸' : 'Body';
---

<section class="section">
  <div class="container">
    <div class="why-band">
      <div class="why-top">
        <div>
          <h2 class="sec-title">{t('home.why_title')}</h2>
          <p set:html={story} />
        </div>

        <!-- 뇌(brain) ↔ 몸(body) 을 잇는 다리 — 이름의 은유를 그림으로 -->
        <svg viewBox="0 0 300 120" aria-hidden="true" role="presentation">
          <circle cx="45" cy="60" r="26" fill="none" stroke="#2153c4" stroke-width="2"></circle>
          <text x="45" y="64" text-anchor="middle" font-size="11" fill="#2153c4" font-weight="600">
            {brainLabel}
          </text>
          <circle cx="255" cy="60" r="26" fill="none" stroke="#2153c4" stroke-width="2"></circle>
          <text x="255" y="64" text-anchor="middle" font-size="11" fill="#2153c4" font-weight="600">
            {bodyLabel}
          </text>
          <path
            d="M75 58 q75 -32 150 0"
            stroke="#7fa1e4"
            stroke-width="2"
            fill="none"
            stroke-dasharray="4 5"></path>
          <path
            d="M75 66 q75 32 150 0"
            stroke="#7fa1e4"
            stroke-width="2"
            fill="none"
            stroke-dasharray="4 5"></path>
          <text x="150" y="63" text-anchor="middle" font-size="10.5" fill="#6b7a94">
            pons · bridge
          </text>
        </svg>
      </div>

      <ul class="pons-grid">
        {
          site.brand.cards.map((card) => (
            <li class="pons-card">
              <span class="letter" aria-hidden="true">
                {card.letter}
              </span>
              <h3>{card.word}</h3>
              <p>{pick(card, 'text', lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why-band {
    background: linear-gradient(160deg, #f4f7fe, #eaf0fc);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .why-top {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
    margin-bottom: 1.875rem;
  }

  .why-top h2 {
    margin-bottom: 0.375rem;
  }

  .why-top p {
    color: var(--body);
    font-size: 0.97rem;
    line-height: 1.72;
    margin: 0;
  }
  .why-top p :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }
  .why-top p :global(em) {
    font-style: italic;
  }

  .why-top svg {
    width: 100%;
    height: auto;
  }

  .pons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.875rem;
  }

  .pons-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.25rem 1.125rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pons-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(33, 83, 196, 0.08);
  }

  .letter {
    display: block;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }

  .pons-card h3 {
    font-family: var(--font-sans);
    font-size: 0.905rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0.5rem 0 0.375rem;
  }

  .pons-card p {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 820px) {
    .why-top {
      grid-template-columns: 1fr;
    }
    .pons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .pons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
