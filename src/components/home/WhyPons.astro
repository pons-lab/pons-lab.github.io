---
import { site } from '../../lib/data.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const story = inlineMd(site.brand.story[lang]);
---

<section class="section why">
  <div class="container">
    <h2>{t('home.why_title')}</h2>
    <p class="story" set:html={story} />

    <!-- 네 머리글자가 한 줄(다리) 위에 선다. 모바일에서는 2×2. -->
    <ul class="letters">
      {
        site.brand.cards.map((card) => (
          <li>
            <span class="letter" aria-hidden="true">
              {card.letter}
            </span>
            <h3>{card.word}</h3>
            <p>{pick(card, 'text', lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--tint);
  }

  h2 {
    margin-bottom: 1.25rem;
  }

  .story {
    max-width: 46em;
    font-size: var(--text-lead);
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
  }
  .story :global(strong) {
    font-weight: 700;
  }

  .letters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* 머리글자 아래 굵은 선이 네 칸을 가로질러 하나로 이어진다.
     장식용 큰 글자라 크기는 이 컴포넌트에 둔다. */
  .letter {
    display: block;
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--accent);
    padding-bottom: 0.1em;
    border-bottom: 2px solid var(--ink);
    margin-right: -2rem;
  }
  .letters li:last-child .letter {
    margin-right: 0;
  }

  h3 {
    font-size: var(--text-xl);
    margin: 1.25rem 0 0.5rem;
  }

  .letters p {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .letters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
    .letter,
    .letters li:last-child .letter {
      margin-right: 0;
    }
  }
</style>
