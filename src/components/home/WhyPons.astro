---
import { site } from '../../lib/data.js';
import { inlineMd } from '../../lib/text.js';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const story = inlineMd(site.brand.story[lang]);
---

<section class="section why">
  <div class="container">
    <div class="top">
      <div class="story">
        <p class="kicker">{t('home.why_kicker')}</p>
        <h2>{t('home.why_title')}</h2>
        <p class="lead" set:html={story} />
      </div>

      <!-- 뇌(brain) ↔ 몸(body) 을 잇는 다리 — 이름의 은유를 그림으로 -->
      <figure class="bridge" aria-hidden="true">
        <svg viewBox="0 0 460 260" role="presentation">
          <defs>
            <linearGradient id="deck" x1="0" x2="1">
              <stop offset="0" stop-color="#2153c4"></stop>
              <stop offset="1" stop-color="#5b8bf0"></stop>
            </linearGradient>
          </defs>

          <!-- 물결(신호)이 흐르는 아래쪽 -->
          <path
            d="M10 214 C 60 200, 88 228, 138 214 C 188 200, 216 228, 266 214 C 316 200, 344 228, 394 214 C 424 205, 438 210, 450 214"
            stroke="#c9d7f2"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"></path>
          <path
            d="M10 234 C 60 220, 88 248, 138 234 C 188 220, 216 248, 266 234 C 316 220, 344 248, 394 234 C 424 225, 438 230, 450 234"
            stroke="#dde5f5"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"></path>

          <!-- 다리 상판 -->
          <path d="M30 150 H430" stroke="url(#deck)" stroke-width="5" stroke-linecap="round"></path>

          <!-- 아치와 케이블 -->
          <path
            d="M30 150 C 120 62, 340 62, 430 150"
            stroke="#2153c4"
            stroke-width="2.4"
            fill="none"
            stroke-linecap="round"
            opacity="0.85"></path>
          <g stroke="#9ab6ee" stroke-width="1.4" stroke-linecap="round">
            <path d="M78 150V112"></path>
            <path d="M126 150V92"></path>
            <path d="M174 150V80"></path>
            <path d="M230 150V76"></path>
            <path d="M286 150V80"></path>
            <path d="M334 150V92"></path>
            <path d="M382 150V112"></path>
          </g>

          <!-- 왼쪽: 뇌 -->
          <g transform="translate(14 108)">
            <circle cx="0" cy="0" r="26" fill="#e8eefc"></circle>
            <path
              d="M-11 6c-5-2-6-9-2-12-2-5 3-10 8-8 3-4 10-3 11 2 5 1 6 8 2 11 1 5-4 9-9 7-3 3-8 2-10 0Z"
              fill="none"
              stroke="#2153c4"
              stroke-width="1.7"
              stroke-linejoin="round"></path>
            <path
              d="M0-14v22M0-4h6M0 3h-6"
              stroke="#2153c4"
              stroke-width="1.3"
              stroke-linecap="round"
              opacity="0.75"></path>
          </g>

          <!-- 오른쪽: 심장(몸) -->
          <g transform="translate(446 108)">
            <circle cx="0" cy="0" r="26" fill="#e8eefc"></circle>
            <path
              d="M0 10c-8-6-13-10-13-16a6.5 6.5 0 0 1 13-2 6.5 6.5 0 0 1 13 2c0 6-5 10-13 16Z"
              fill="none"
              stroke="#2153c4"
              stroke-width="1.7"
              stroke-linejoin="round"></path>
          </g>

          <!-- 다리를 건너는 신호 -->
          <circle class="spark" cx="30" cy="150" r="4.5" fill="#16233b"></circle>
        </svg>
        <figcaption class="bridge-cap">
          <span>brain</span>
          <span class="bridge-word">pons · bridge</span>
          <span>body</span>
        </figcaption>
      </figure>
    </div>

    <ul class="grid grid-4 cards">
      {
        site.brand.cards.map((card) => (
          <li class="card pons-card">
            <span class="letter" aria-hidden="true">
              {card.letter}
            </span>
            <h3>{card.word}</h3>
            <p>{pick(card, 'text', lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background:
      radial-gradient(900px 420px at 92% 4%, #eff3fc 0%, rgba(239, 243, 252, 0) 66%),
      #f6f8fc;
    border-block: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  .story h2 {
    margin-bottom: 0.9rem;
  }

  .story .lead {
    max-width: 56ch;
    margin-bottom: 0;
  }

  .story .lead :global(strong) {
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .story .lead :global(em) {
    font-style: italic;
    color: var(--body);
  }

  .bridge {
    margin: 0;
  }
  .bridge svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spark {
    animation: cross 4.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes cross {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateX(400px);
      opacity: 0;
    }
  }

  .bridge-cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.35rem;
    padding-inline: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bridge-word {
    color: var(--accent);
    font-family: var(--font-display);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.83rem;
    font-style: italic;
  }

  .cards {
    align-items: stretch;
  }

  .pons-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .letter {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
    margin-bottom: 0.55rem;
  }

  .pons-card h3 {
    font-family: var(--font-sans);
    font-size: 0.775rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .pons-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.62;
    color: var(--body);
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .bridge {
      max-width: 460px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark {
      animation: none;
      opacity: 0;
    }
  }
</style>
