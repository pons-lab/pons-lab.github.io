---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{
  site.recruiting?.open && (
    <div class="container">
      <aside class="ribbon">
        <span class="dot" aria-hidden="true" />
        <span class="text">
          <b>{t('home.recruiting_label')}</b> — {site.recruiting[lang]}{' '}
          <a href={localizePath('/contact', lang)}>{t('cta.learn_more')}</a>
        </span>
      </aside>
    </div>
  )
}

<style>
  .ribbon {
    background: var(--accent-soft);
    border: 1px solid #d6e2fa;
    border-radius: var(--radius);
    padding: 0.875rem 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.875rem;
    color: #23407e;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .text b {
    color: #1a3268;
    font-weight: 700;
  }

  .ribbon a {
    text-decoration: underline;
    font-weight: 600;
    color: var(--accent-deep);
    white-space: nowrap;
  }
</style>
