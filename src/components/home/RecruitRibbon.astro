---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{
  site.recruiting?.open && (
    <aside class="container">
      <div class="notice">
        <p class="text">
          <strong>{t('home.recruiting_label')}</strong>
          <span>{site.recruiting[lang]}</span>
        </p>
        <a class="link-arrow" href={localizePath('/contact', lang)}>
          {t('cta.join')}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="m9 18 6-6-6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </aside>
  )
}

<style>
  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .text {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    flex: 1 1 22rem;
    min-width: 0;
    margin: 0;
    font-size: var(--text-md);
    color: var(--text-3);
  }
  .text strong {
    font-weight: 700;
    color: var(--text-1);
    white-space: nowrap;
  }
  .text span {
    flex: 1 1 18rem;
    min-width: 0;
  }

  .link-arrow {
    flex: none;
  }
</style>
