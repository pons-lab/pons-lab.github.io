---
import { site } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{
  site.recruiting?.open && (
    <aside class="ribbon">
      <div class="container inner">
        <strong class="label">{t('home.recruiting_label')}</strong>
        <p class="text">{site.recruiting[lang]}</p>
        <a class="link-arrow" href={localizePath('/contact', lang)}>
          {t('cta.join')}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </aside>
  )
}

<style>
  .ribbon {
    background: var(--tint);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    padding-block: 1.1rem;
  }

  .label {
    flex: none;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--accent-deep);
  }

  .text {
    margin: 0;
    flex: 1 1 22rem;
    min-width: 0;
    font-size: var(--text-lg);
    color: var(--ink);
  }

  .link-arrow {
    color: var(--accent-deep);
    flex: none;
  }
</style>
