---
import { research } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section">
  <div class="container">
    <div class="head">
      <h2>{t('home.research_title')}</h2>
      <p class="lead">{t('home.research_lead')}</p>
    </div>

    <!-- 세 연구 축을 카드가 아니라 굵은 선 아래 세 기둥으로 나란히 둔다. -->
    <div class="pillars">
      {
        research.axes.map((axis) => (
          <article>
            <h3>
              <a href={localizePath('/research', lang)}>{pick(axis, 'title', lang)}</a>
            </h3>
            <p>{pick(axis, 'lead', lang)}</p>
            <ul>
              {axis.topics.map((topic) => (
                <li>{pick(topic, 'title', lang)}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="more">
      <a class="link-arrow" href={localizePath('/research', lang)}>
        {t('cta.research')}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head h2,
  .head .lead {
    margin: 0;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
  }

  .pillars article {
    padding: 1.75rem 2rem 0.5rem 0;
    border-right: 1px solid var(--line);
  }
  .pillars article + article {
    padding-left: 2rem;
  }
  .pillars article:last-child {
    border-right: 0;
  }

  h3 {
    margin-bottom: 0.75rem;
  }
  h3 a {
    color: inherit;
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .pillars p {
    font-size: var(--text-lg);
    margin-bottom: 1rem;
  }

  .pillars li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--text-md);
    font-weight: 550;
    color: var(--ink);
  }

  .more {
    margin: clamp(1.75rem, 3vw, 2.4rem) 0 0;
  }

  @media (max-width: 900px) {
    .head,
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
    .pillars article,
    .pillars article + article {
      padding: 1.5rem 0 0.5rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .pillars article:last-child {
      border-bottom: 0;
    }
  }
</style>
