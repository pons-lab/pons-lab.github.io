---
import { Image } from 'astro:assets';
import { research } from '../../lib/data.js';
import { asset } from '../../lib/images.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tagsOf = (axis) => (lang === 'ko' ? axis.tags_ko || axis.tags_en : axis.tags_en) ?? [];
---

<section class="section">
  <div class="container">
    <h2 class="sec-title">{t('home.research_title')}</h2>
    <p class="sec-sub">{t('home.research_lead')}</p>

    <div class="res-grid">
      {
        research.axes.map((axis) => {
          const img = asset(axis.image);
          return (
            <a class="res-card" href={localizePath('/research', lang)}>
              <div class="thumb">
                {img ? (
                  <Image src={img} alt={pick(axis, 'title', lang)} width={520} height={300} />
                ) : (
                  <svg viewBox="0 0 260 90" aria-hidden="true" role="presentation">
                    <path
                      d="M0 52 L34 52 44 30 54 70 64 40 74 58 86 46 100 52 118 22 130 76 142 38 156 60 172 50 190 52 202 34 214 66 226 44 240 54 260 50"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle cx="118" cy="22" r="3.6" fill="currentColor" />
                  </svg>
                )}
              </div>
              <div class="body">
                <h3>{pick(axis, 'title', lang)}</h3>
                <p>{pick(axis, 'lead', lang)}</p>
                <div class="tags">
                  {tagsOf(axis).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <a class="more" href={localizePath('/research', lang)}>{t('cta.research')} →</a>
  </div>
</section>

<style>
  .res-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .res-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .res-card:hover {
    border-color: #bcd0f5;
    box-shadow: 0 8px 24px rgba(33, 83, 196, 0.08);
    text-decoration: none;
  }

  .thumb {
    height: 150px;
    background: linear-gradient(135deg, #dbe6fb, #eef3fd);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8aa3d4;
    overflow: hidden;
  }
  .thumb svg {
    width: 72%;
    max-width: 260px;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 1.375rem 1.5rem;
  }

  .res-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .res-card p {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.62;
  }

  .tags {
    margin-top: 0.875rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .more {
    margin-top: 1.625rem;
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .res-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
