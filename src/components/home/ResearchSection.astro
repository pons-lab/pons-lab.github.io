---
import { asset } from '../../lib/images.js';
import { research } from '../../lib/data.js';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 카드 그림과 출처는 research.yaml 의 home_image, home_image_credit 에서 온다.
const figureOf = (axis) => ({
  src: asset(axis.home_image)?.src ?? null,
  credit: axis.home_image_credit,
});
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>{t('home.research_title')}</h2>
      <p class="lead">{t('home.research_lead')}</p>
    </div>

    <div class="grid grid-3 axes">
      {
        research.axes.map((axis) => (
          <a class="card card-hover axis" href={localizePath('/research', lang)}>
            {figureOf(axis).src && (
              <span class="figure">
                <img src={figureOf(axis).src} alt="" loading="lazy" />
              </span>
            )}
            <h3>{pick(axis, 'title', lang)}</h3>
            <ul class="topics">
              {axis.topics.map((topic) => (
                <li>{pick(topic, 'title', lang)}</li>
              ))}
            </ul>
            {figureOf(axis).credit && (
              <span class="credit" lang="en">{figureOf(axis).credit}</span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .axis {
    display: block;
    overflow: hidden;
    color: inherit;
  }
  .figure {
    display: block;
    margin: -1.5rem -1.5rem 1.25rem;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
  }
  .figure img {
    width: 100%;
    height: 100%;
    /* 도식이 잘리지 않게 그림 전체를 보여준다 */
    object-fit: contain;
  }
  .credit {
    display: block;
    margin-top: 0.75rem;
    font-size: var(--text-3xs);
    color: var(--text-4);
  }
  .axis:hover {
    text-decoration: none;
  }
  .axis h3 {
    margin-bottom: 1rem;
    transition: color 0.2s;
  }
  .axis:hover h3 {
    color: var(--accent-fg);
  }

  .topics {
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-md);
    color: var(--text-4);
  }
</style>
