---
// 메인 페이지 본문. 영문(/)과 한국어(/ko/) 두 페이지가 이 컴포넌트를 함께 씁니다.
// 섹션 순서는 CLAUDE.md 확정안을 따릅니다.
import Hero from './home/Hero.astro';
import RecruitRibbon from './home/RecruitRibbon.astro';
import ResearchSection from './home/ResearchSection.astro';
import WhyPons from './home/WhyPons.astro';
import NewsSection from './home/NewsSection.astro';
import PublicationsSection from './home/PublicationsSection.astro';
import JoinBand from './home/JoinBand.astro';
---

<Hero />
<RecruitRibbon />
<ResearchSection />
<WhyPons />
<section class="section">
  <div class="container two">
    <NewsSection />
    <PublicationsSection />
  </div>
</section>
<JoinBand />

<style>
  /* 최근 소식과 대표 논문을 나란히. 좁은 화면에서는 위아래로 쌓는다. */
  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 4.5rem);
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
