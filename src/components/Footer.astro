---
import Affiliation from './Affiliation.astro';
import { site, fullAddress } from '../lib/data.js';
import { keepTogether } from '../lib/text.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 병기 원칙: 한국어 페이지에서는 국문명 + 영문 약칭을 함께 표기한다.
const labName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
// 푸터는 교수 연구실 기준
const office = site.contact.office;
const address = fullAddress(office, lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="name">{keepTogether(labName)}</p>
      <p class="tag">{site.tagline[lang]}</p>
      <p class="affil"><Affiliation /></p>
    </div>

    <div class="col pages">
      <h2>{t('footer.pages')}</h2>
      <ul>
        <li><a href={localizePath('/', lang)}>{t('nav.home')}</a></li>
        {
          navItems.map((item) => (
            <li>
              <a href={localizePath(item.path, lang)}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col">
      <h2>{t('footer.contact')}</h2>
      <ul>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href={`tel:${office.phone}`}>{office.phone_display}</a></li>
        <li class="addr">{address}</li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name.short_en}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.885rem;
    line-height: 1.7;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(2.25rem, 4vw, 3rem) 1.75rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.35rem;
    line-height: 1.35;
  }

  .tag {
    color: #93b4f5;
    margin: 0 0 0.85rem;
  }

  .affil {
    margin: 0;
    max-width: 34ch;
  }

  .col h2 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 0.85rem;
  }

  .col ul {
    display: grid;
    gap: 0.42rem;
  }

  /* 링크가 8개라 한 줄로 세우면 푸터가 길어진다. 2열로 접는다. */
  .pages ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.42rem 1.5rem;
  }

  .col a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .addr {
    max-width: 32ch;
    color: rgba(255, 255, 255, 0.55);
  }

  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.35rem 1.75rem;
  }
  .bottom p {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
