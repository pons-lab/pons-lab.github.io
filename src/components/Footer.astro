---
import Affiliation from './Affiliation.astro';
import Address from './Address.astro';
import ServiceIcon from './ServiceIcon.astro';
import { site, members } from '../lib/data.js';
import { keepTogether } from '../lib/text.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 병기 원칙: 한국어 페이지에서는 국문명 + 영문 약칭을 함께 표기한다.
const labName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
// 푸터는 교수 연구실 기준
const office = site.contact.office;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="name">{keepTogether(labName)}</p>
      <p class="affil"><Affiliation /></p>
      <ul class="social">
        <li>
          <a class="t-iconbtn" href={site.github_url} target="_blank" rel="noopener" aria-label="GitHub">
            <ServiceIcon name="github" size={20} />
          </a>
        </li>
        {members.pi.scholar_url && (
          <li>
            <a class="t-iconbtn" href={members.pi.scholar_url} target="_blank" rel="noopener" aria-label="Google Scholar">
              <ServiceIcon name="scholar" size={20} />
            </a>
          </li>
        )}
        {members.pi.orcid && (
          <li>
            <a class="t-iconbtn" href={`https://orcid.org/${members.pi.orcid}`} target="_blank" rel="noopener" aria-label="ORCID">
              <ServiceIcon name="orcid" size={20} />
            </a>
          </li>
        )}
      </ul>
    </div>

    <div class="col pages">
      <h2>{t('footer.pages')}</h2>
      <ul>
        <li><a href={localizePath('/', lang)}>{t('nav.home')}</a></li>
        {
          navItems.map((item) => (
            <li>
              <a href={localizePath(item.path, lang)}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col">
      <h2>{t('footer.contact')}</h2>
      <ul>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href={`tel:${office.phone}`}>{office.phone_display}</a></li>
        <li class="addr"><Address place={office} stack /></li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name.short_en}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-2);
    color: var(--text-4);
    font-size: var(--text-md);
    line-height: 1.6;
    padding-block: 3.125rem 4rem;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
  }

  .name {
    font-weight: 700;
    color: var(--text-2);
    margin: 0 0 0.75rem;
  }

  .affil {
    margin: 0;
    max-width: 34ch;
    font-size: var(--text-xs);
    color: var(--text-5);
  }

  .social {
    display: flex;
    gap: 0.25rem;
    margin: 1rem 0 0 -0.625rem;
  }

  .col h2 {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-2);
    margin: 0 0 0.75rem;
  }

  .col ul {
    display: grid;
    gap: 0.25rem;
  }

  /* 링크가 8개라 한 줄로 세우면 푸터가 길어진다. 2열로 접는다. */
  .pages ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
  }

  .col a {
    color: var(--text-4);
  }
  .col a:hover {
    text-decoration: underline;
  }

  .addr {
    max-width: 32ch;
    font-size: var(--text-xs);
    color: var(--text-5);
  }

  .bottom {
    padding-top: 2rem;
  }
  .bottom p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-5);
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
