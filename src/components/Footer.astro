---
import { site } from '../lib/data.js';
import { navItems } from '../i18n/ui.js';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 병기 원칙: 한국어 페이지에서는 국문명 + 영문 약칭을 함께 표기한다.
const labFullName = lang === 'ko' ? site.name.display_ko : site.name.full_en;
const affiliation =
  lang === 'ko'
    ? `${site.institution.university_ko} ${site.institution.department_ko}`
    : `${site.institution.department_en}, ${site.institution.university_en}`;
const address = lang === 'ko' ? site.contact.address_ko : site.contact.address_en;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="col about">
      <b>{site.name.short_en}</b>
      <p>{labFullName}</p>
      <p>{affiliation}</p>
    </div>

    <nav class="col links" aria-label={t('footer.pages')}>
      <h2>{t('footer.pages')}</h2>
      <ul>
        <li><a href={localizePath('/', lang)}>{t('nav.home')}</a></li>
        {
          navItems.map((item) => (
            <li>
              <a href={localizePath(item.path, lang)}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col contact">
      <h2>{t('footer.contact')}</h2>
      <p>{address}</p>
      <p>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <span class="sep">·</span>
        <a href={`tel:${site.contact.phone}`}>{site.contact.phone_display}</a>
      </p>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name.short_en}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #0b1322;
    color: #8fa0be;
    font-size: 0.845rem;
    line-height: 1.68;
    margin-top: clamp(3.5rem, 7vw, 5.25rem);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: 3rem 2rem;
  }

  .col p {
    margin: 0 0 0.2rem;
  }

  .about b {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    display: block;
    margin-bottom: 0.625rem;
  }
  .about p:first-of-type {
    color: #a9b8d2;
  }

  .col h2 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f7291;
    margin: 0 0 0.75rem;
  }

  .links ul {
    display: grid;
    gap: 0.34rem;
  }

  .site-footer a {
    color: #8fa0be;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .contact p {
    max-width: 34ch;
  }

  .sep {
    margin-inline: 0.35rem;
    opacity: 0.5;
  }

  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 1.15rem 1.6rem;
  }
  .bottom p {
    margin: 0;
    font-size: 0.775rem;
    color: #5b6b88;
  }

  @media (max-width: 780px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 500px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
