---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils.js';

const t = useTranslations('en');
---

<BaseLayout title={t('notfound.title')}>
  <section class="section notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>{t('notfound.title')}</h1>
      <p class="lead">{t('notfound.lead')}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">{t('cta.back_home')}</a>
        <a class="btn btn-ghost" href="/ko/">한국어 홈</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    opacity: 0.22;
    margin: 0 0 0.5rem;
  }
  .lead {
    margin-bottom: 1.75rem;
  }
</style>
